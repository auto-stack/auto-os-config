name: "auto-os-config-front"
version: "0.1.0"
scene: "ui"
render: "vue"
shadcn: off
default_classes: off
# Plan 011 T2:外部 back(Plan 061 链接式契约)。vm merged 模式把 `back.api`
# 解析到 ../auto-os-config-back/api.at,并装载其 cdylib(需先
# `cargo build` 于 auto-os-config-back/)。vue 轨不受影响(resolve_back_api
# 本地 src/back/api.at 优先,regen 行为不变)。
back: { project: "../auto-os-config-back" }

# auto-lang Plan 501:vm 桌面外部仓 app 声明——desktop launch 臂据此确保
# os-config daemon 就绪(ping :17701 → 发现序 spawn)并注入 AUTOOS_DAEMON
# env 到 App 会话(vm track 既有约定,api.at daemon_base() 消费)。
# vue 轨/regen 不读此键,零影响。
daemon: "autoos"

