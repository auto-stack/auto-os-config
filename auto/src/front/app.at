// app.at — shared root for BOTH backends (Plan 008 batch 6): vue (regen →
// App.vue, mounted by src/main.ts) and vm (auto run -r vm). Replaces the
// vm-only root (Plan 007) and app_shell.at (Plan 006 form: named classes +
// style block) — one view source per widget, unified style vocabulary.
//
// Conventions per sidebar.at (batch 1): bare store imports + `.store.x`
// references, marker classes (app-layout/content-header/content-body/
// state-msg) are INERT test hooks, neutrals are deterministic hex, accent
// only via `primary`, no fractional spacing, row/col styles always carry
// explicit flex + gap.
//
// gap-[0px] (2026-08-27 像素对拍): row/col 会被 vue codegen 无条件注入
// `gap-4`，而 Tailwind CSS 里 .gap-4 排在 .gap-0 之后 → 源码 gap-0 必输。
// 任意值形式（gap-[0px]/gap-[10px]…）排在 scale 值之后，稳定获胜。
// 状态文案包一层 flex-1 居中 col（css-era .state-msg 是 height:100% 居中）。
//
// The `key:` on each content child forces a fresh instance per module on
// vue so per-module state (editor drafts) rebinds on switch — the trick the
// hand-written shell used (Plan 006). vm child widgets have no auto-Init,
// so the Load button (batch 3) covers the reload path there.
use modules_store: Modules
use sidebar: Sidebar
use daemon_view: DaemonView
use config_editor: ConfigEditor
use collection_browser: CollectionBrowser
use theme_store: Theme
use back.api: system_info, fetchModulesRaw, modulesCount, moduleAt

widget App {
    msg Msg { Init, SelectModule(str) }

    model {
        // Plan 011 T9/T12:概要页 Dashboard(system_info 真数据;App 直调形态,
        // 015-notes App handler 直调 back.api 先例——免三 store 消歧)。
        // 概要页二期(本次):软件信息面(os_edition/kernel/arch/uptime,
        // 后端同批新增)+ 图形化(SVG donut/进度条/icon,442 A4 直通)。
        var sys_host str = ""
        var sys_os_edition str = ""
        var sys_os_build str = ""
        var sys_kernel str = ""
        var sys_arch str = ""
        var sys_uptime str = ""
        var sys_cpu str = ""
        var sys_cpu_name str = ""
        var sys_cpu_cores str = ""
        var sys_mem_used str = ""
        var sys_mem_dash str = "0 100"
        var sys_mem_display str = ""
        var disks Array<any> = []
        var gpus Array<str> = []
        // Managed Modules 卡:独立 fetch 计数(不经 Modules store,免
        // fire-and-forget Init 的时序竞态;原语与 modules_store 同款)。
        // int 形态:modulesCount() 契约返回 number,生成 TS 直配。
        var sys_mod_total int = 0
        var sys_mod_files int = 0
        var sys_mod_coll int = 0
    }

    view {
        row (style: "app-layout h-full w-full flex flex-row gap-[0px]") {
            Sidebar { }
            col (style: "flex-1 flex flex-col gap-[0px]") {
                row (style: "content-header h-[48px] w-full shrink-0 flex flex-row items-center gap-[0px] px-6 border-b border-border bg-background") {
                    text (text: .store.title, style: "text-xl font-semibold text-foreground") {}
                }
                col (style: "content-body flex-1 flex flex-col gap-[0px] overflow-auto p-6 bg-background") {
                    if .store.loading {
                        col (style: "state-msg flex-1 flex flex-col items-center justify-center gap-[0px]") {
                            text (text: "Loading configuration...", style: "text-base text-muted") {}
                        }
                    }
                    if .store.loading == false && .store.error != "" {
                        col (style: "state-msg error flex-1 flex flex-col items-center justify-center gap-[0px]") {
                            text (text: "⚠️ " + .store.error, style: "text-base text-[#c42b1c]") {}
                        }
                    }
                    if .store.loading == false && .store.error == "" {
                        if .store.active_kind == "" {
                            // T18/T12: 默认落地页 = 系统信息 Dashboard。二期重设计
                            // (参考 Win11 设置·关于/任务管理器性能页):Hero(设备+
                            // 系统+uptime)→ Hardware(CPU/GPU/Memory donut/Storage
                            // 进度条)→ Software(OS 版本面 + Managed Modules 计数)。
                            // 图形元素走 SVG 直通(442 A4);accent 只经 primary
                            // token;概要页不出现任何 button(446 note:概要页卡片
                            // 文案曾误配 nav 断言——新版无按钮且文案避开导航名)。
                            col (style: "overview flex-1 flex flex-col gap-[0px] overflow-auto p-8 bg-background") {
                                text (text: "System Overview", style: "text-xs font-semibold text-muted tracking-wider uppercase pb-3") {}
                                row (style: "w-full flex flex-row items-center gap-5 pb-6") {
                                    col (style: "device-tile h-16 w-16 rounded-2xl bg-primary/10 flex flex-row items-center justify-center gap-[0px] shrink-0") {
                                        svg (viewBox: "0 0 24 24", style: "h-8 w-8 text-primary") {
                                            rect (x: "2", y: "3", width: "20", height: "14", rx: "2", ry: "2", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round") {}
                                            line (x1: "8", y1: "21", x2: "16", y2: "21", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                            line (x1: "12", y1: "17", x2: "12", y2: "21", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                        }
                                    }
                                    col (style: "flex flex-col gap-[2px] min-w-0") {
                                        text (text: .sys_host, style: "text-2xl font-semibold text-foreground") {}
                                        text (text: .sys_os_edition + " · " + .sys_os_build + " · " + .sys_arch, style: "text-sm text-muted-foreground") {}
                                    }
                                    col (style: "flex-1 flex flex-col gap-[0px]") {}
                                    col (style: "flex flex-col items-end gap-[2px] shrink-0") {
                                        row (style: "flex flex-row items-center gap-1") {
                                            svg (viewBox: "0 0 24 24", style: "h-[14px] w-[14px] text-muted") {
                                                circle (cx: "12", cy: "12", r: "10", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round") {}
                                                polyline (points: "12 6 12 12 16 14", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round") {}
                                            }
                                            text (text: "Uptime", style: "text-xs text-muted") {}
                                        }
                                        text (text: .sys_uptime, style: "text-sm font-medium text-foreground") {}
                                    }
                                }
                                text (text: "Hardware", style: "text-xs font-semibold text-muted tracking-wider uppercase pb-2") {}
                                row (style: "w-full flex flex-row gap-4 pb-4") {
                                    col (style: "ov-panel flex-1 flex flex-col gap-3 rounded-xl border border-border bg-card px-5 py-4 min-h-[144px]") {
                                        row (style: "flex flex-row items-center gap-2") {
                                            svg (viewBox: "0 0 24 24", style: "h-4 w-4 text-primary shrink-0") {
                                                rect (x: "4", y: "4", width: "16", height: "16", rx: "2", ry: "2", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round") {}
                                                rect (x: "9", y: "9", width: "6", height: "6", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round") {}
                                                line (x1: "9", y1: "2", x2: "9", y2: "4", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                                line (x1: "15", y1: "2", x2: "15", y2: "4", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                                line (x1: "9", y1: "20", x2: "9", y2: "22", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                                line (x1: "15", y1: "20", x2: "15", y2: "22", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                                line (x1: "2", y1: "9", x2: "4", y2: "9", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                                line (x1: "2", y1: "15", x2: "4", y2: "15", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                                line (x1: "20", y1: "9", x2: "22", y2: "9", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                                line (x1: "20", y1: "15", x2: "22", y2: "15", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                            }
                                            text (text: "Processor", style: "text-sm font-semibold text-foreground") {}
                                        }
                                        text (text: .sys_cpu_name, style: "text-sm text-foreground") {}
                                        text (text: .sys_cpu_cores + " logical cores", style: "text-xs bg-primary/10 text-primary rounded-full px-[10px] py-[2px] w-fit") {}
                                        text (text: .sys_cpu, style: "text-xs text-muted") {}
                                    }
                                    col (style: "ov-panel flex-1 flex flex-col gap-3 rounded-xl border border-border bg-card px-5 py-4 min-h-[144px]") {
                                        row (style: "flex flex-row items-center gap-2") {
                                            svg (viewBox: "0 0 24 24", style: "h-4 w-4 text-primary shrink-0") {
                                                rect (x: "2", y: "3", width: "20", height: "14", rx: "2", ry: "2", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round") {}
                                                line (x1: "8", y1: "21", x2: "16", y2: "21", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                                line (x1: "12", y1: "17", x2: "12", y2: "21", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                            }
                                            text (text: "Graphics", style: "text-sm font-semibold text-foreground") {}
                                        }
                                        for gpu in .gpus {
                                            row (style: "flex flex-row items-center gap-2") {
                                                col (style: "h-[6px] w-[6px] rounded-full bg-primary shrink-0") {}
                                                text (text: gpu, style: "text-sm text-foreground") {}
                                            }
                                        }
                                        if .gpus.len() == 0 {
                                            text (text: "No GPU detected", style: "text-sm text-muted") {}
                                        }
                                    }
                                }
                                row (style: "w-full flex flex-row gap-4 pb-6") {
                                    col (style: "ov-panel flex-1 flex flex-col gap-3 rounded-xl border border-border bg-card px-5 py-4 min-h-[207px]") {
                                        row (style: "flex flex-row items-center gap-2") {
                                            svg (viewBox: "0 0 24 24", style: "h-4 w-4 text-primary shrink-0") {
                                                rect (x: "2", y: "6", width: "20", height: "8", rx: "2", ry: "2", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round") {}
                                                line (x1: "8", y1: "9", x2: "8", y2: "11", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                                line (x1: "12", y1: "9", x2: "12", y2: "11", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                                line (x1: "16", y1: "9", x2: "16", y2: "11", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                                line (x1: "6", y1: "14", x2: "6", y2: "17", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                                line (x1: "10", y1: "14", x2: "10", y2: "17", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                                line (x1: "14", y1: "14", x2: "14", y2: "17", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                                line (x1: "18", y1: "14", x2: "18", y2: "17", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                            }
                                            text (text: "Memory", style: "text-sm font-semibold text-foreground") {}
                                        }
                                        row (style: "flex flex-row items-center gap-5") {
                                            svg (viewBox: "0 0 36 36", style: "mem-donut h-[96px] w-[96px] shrink-0 text-primary") {
                                                circle (cx: "18", cy: "18", r: "15.9155", fill: "none", stroke: "#e5e7eb", stroke-width: "5") {}
                                                circle (cx: "18", cy: "18", r: "15.9155", fill: "none", stroke: "currentColor", stroke-width: "5", stroke-linecap: "round", stroke-dasharray: .sys_mem_dash, stroke-dashoffset: "25", style: "text-primary") {}
                                            }
                                            col (style: "flex flex-col gap-[2px]") {
                                                row (style: "flex flex-row items-baseline gap-[6px]") {
                                                    text (text: .sys_mem_used + "%", style: "text-2xl font-semibold text-foreground") {}
                                                    text (text: "used", style: "text-xs text-muted") {}
                                                }
                                                text (text: .sys_mem_display, style: "text-xs text-muted-foreground") {}
                                            }
                                        }
                                    }
                                    col (style: "ov-panel flex-1 flex flex-col gap-3 rounded-xl border border-border bg-card px-5 py-4 min-h-[207px]") {
                                        row (style: "flex flex-row items-center gap-2") {
                                            svg (viewBox: "0 0 24 24", style: "h-4 w-4 text-primary shrink-0") {
                                                line (x1: "22", y1: "12", x2: "2", y2: "12", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                                path (d: "M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round") {}
                                                line (x1: "6", y1: "16", x2: "6.01", y2: "16", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                                line (x1: "10", y1: "16", x2: "10.01", y2: "16", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                            }
                                            text (text: "Storage", style: "text-sm font-semibold text-foreground") {}
                                        }
                                        col (style: "flex flex-col gap-[10px]") {
                                            for dsk in .disks {
                                                col (style: "flex flex-col gap-[4px]") {
                                                    row (style: "w-full flex flex-row items-center justify-between") {
                                                        row (style: "flex flex-row items-center gap-2") {
                                                            text (text: dsk.drive, style: "text-xs font-semibold text-foreground") {}
                                                            text (text: dsk.pct + "%", style: "text-xs text-muted-foreground") {}
                                                        }
                                                        text (text: dsk.free + " / " + dsk.total + " GB free", style: "text-xs text-muted") {}
                                                    }
                                                    // 概要页三期(2026-08-29):内联 style 进度条(条形在
                                                    // vm 轨被 aavm 忽略,恒灰底无比例) → AutoUI progress
                                                    // 组件(双端原生:vue shadcn Progress / vm
                                                    // ProgressBar;上游同期修复 convert_progress 循环
                                                    // bindings——空 bindings 版循环内 value 恒 0)。
                                                    // 磁盘水位分级色(>75 红 / >60 橙 / 其余主色):
                                                    // vue 轨由 styles.css 的 progress 变体消费 marker
                                                    // class;vm 轨 ProgressBar 填充色硬编码不吃 class,
                                                    // 属上游缺口(残差台账既有先例)。
                                                    progress (value: dsk.pct, max: 100, style: "w-full h-2",
                                                              class: dsk.pct > 75 ? "ov-disk-crit" : dsk.pct > 60 ? "ov-disk-warn" : "") {}
                                                }
                                            }
                                        }
                                    }
                                }
                                text (text: "Software", style: "text-xs font-semibold text-muted tracking-wider uppercase pb-2") {}
                                row (style: "w-full flex flex-row gap-4") {
                                    col (style: "ov-panel flex-1 flex flex-col gap-3 rounded-xl border border-border bg-card px-5 py-4 min-h-[159px]") {
                                        row (style: "flex flex-row items-center gap-2") {
                                            svg (viewBox: "0 0 24 24", style: "h-4 w-4 text-primary shrink-0") {
                                                rect (x: "2", y: "4", width: "20", height: "16", rx: "2", ry: "2", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round") {}
                                                line (x1: "2", y1: "8", x2: "22", y2: "8", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                                line (x1: "6", y1: "4", x2: "6", y2: "8", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                                line (x1: "10", y1: "4", x2: "10", y2: "8", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                            }
                                            text (text: "Operating System", style: "text-sm font-semibold text-foreground") {}
                                        }
                                        col (style: "flex flex-col gap-[6px]") {
                                            row (style: "flex flex-row gap-3") {
                                                text (text: "Edition", style: "text-xs text-muted w-24 shrink-0") {}
                                                text (text: .sys_os_edition, style: "text-sm text-foreground") {}
                                            }
                                            row (style: "flex flex-row gap-3") {
                                                text (text: "Kernel", style: "text-xs text-muted w-24 shrink-0") {}
                                                text (text: .sys_kernel, style: "text-sm text-foreground") {}
                                            }
                                            row (style: "flex flex-row gap-3") {
                                                text (text: "OS build", style: "text-xs text-muted w-24 shrink-0") {}
                                                text (text: .sys_os_build, style: "text-sm text-foreground") {}
                                            }
                                            row (style: "flex flex-row gap-3") {
                                                text (text: "Architecture", style: "text-xs text-muted w-24 shrink-0") {}
                                                text (text: .sys_arch, style: "text-sm text-foreground") {}
                                            }
                                        }
                                    }
                                    col (style: "ov-panel flex-1 flex flex-col gap-3 rounded-xl border border-border bg-card px-5 py-4 min-h-[159px]") {
                                        row (style: "flex flex-row items-center gap-2") {
                                            svg (viewBox: "0 0 24 24", style: "h-4 w-4 text-primary shrink-0") {
                                                rect (x: "3", y: "3", width: "7", height: "7", rx: "1", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round") {}
                                                rect (x: "14", y: "3", width: "7", height: "7", rx: "1", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round") {}
                                                rect (x: "14", y: "14", width: "7", height: "7", rx: "1", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round") {}
                                                rect (x: "3", y: "14", width: "7", height: "7", rx: "1", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round") {}
                                            }
                                            text (text: "Managed Modules", style: "text-sm font-semibold text-foreground") {}
                                        }
                                        row (style: "flex flex-row items-baseline gap-2") {
                                            text (text: .sys_mod_total, style: "text-2xl font-semibold text-foreground") {}
                                            text (text: "modules under management", style: "text-sm text-muted-foreground") {}
                                        }
                                        row (style: "flex flex-row gap-2") {
                                            text (text: .sys_mod_files + " config files", style: "text-xs bg-primary/10 text-primary rounded-full px-[10px] py-[2px]") {}
                                            text (text: .sys_mod_coll + " collections", style: "text-xs bg-primary/10 text-primary rounded-full px-[10px] py-[2px]") {}
                                        }
                                        text (text: "Served by the unified AutoOS config daemon", style: "text-xs text-muted") {}
                                    }
                                }
                            }
                            }
                        if .store.active_kind == "file" {
                            if .store.active_id == "ai-daemon" {
                                DaemonView(module_id: .store.active_id, key: .store.active_id) { }
                                ConfigEditor(module_id: .store.active_id, key: "aaid-cfg") { }
                            }
                            if .store.active_id != "ai-daemon" {
                                ConfigEditor(module_id: .store.active_id, key: .store.active_id) { }
                            }
                        }
                        if .store.active_kind == "collection" {
                            CollectionBrowser(module_id: .store.active_id, read_only: .store.read_only, key: .store.active_id) { }
                        }
                        if .store.active_kind != "" && .store.active_kind != "file" && .store.active_kind != "collection" {
                            col (style: "state-msg flex-1 flex flex-col items-center justify-center gap-[0px]") {
                                text (text: "Custom remote modules were removed in Plan 006 (createComponent(Vue) protocol retired).", style: "text-base text-muted") {}
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            // plan446 批二 A1:App 同持 Modules+Theme 两 store,裸 store.Init 现歧义报错;
            // 旧 codegen 里 store 即首个 use(Modules),显式限定语义不变。
            Modules.Init()
            // plan010: vm 轨无 auto-Init——accent 从 autoos-ui.json 读回需在根
            // Init 链上显式触发（vue 端 useTheme onMounted 同源，幂等）。
            Theme.Init()
            // Plan 011 T9/T12:概要页 Dashboard 真数据(back.api 桥/HTTP 双传输)。
            // 上游④已修复(Plan 474):payload 恢复原始数值(浮点),视图侧
            // floor 取整 + 图形化构建(SVG donut / :style 进度条,442 A4)。
            var r = system_info()
            .sys_host = r.hostname
            .sys_os_edition = r.os_edition
            .sys_os_build = r.os_version
            .sys_kernel = r.kernel
            .sys_arch = r.arch
            .sys_cpu = r.cpu
            .sys_cpu_name = r.cpu_name
            .sys_cpu_cores = r.cpu_cores
            // 系统开机时长(秒 → "1d 6h 32m" / "6h 32m" / "32m";`/` 是真除法
            // 产浮点(实测 1.2757d),display 前必须 math.floor(vm native
            // 1710,双轨可用)。
            var us = r.uptime_s
            var ud = math.floor(us / 86400)
            var uh = math.floor((us - ud * 86400) / 3600)
            var um = math.floor((us - ud * 86400 - uh * 3600) / 60)
            if ud > 0 {
                .sys_uptime = ud + "d " + uh + "h " + um + "m"
            }
            if ud == 0 && uh > 0 {
                .sys_uptime = uh + "h " + um + "m"
            }
            if ud == 0 && uh == 0 {
                .sys_uptime = um + "m"
            }
            // 内存 donut:stroke-dasharray "used rest"(r=15.9155 → 周长 100,
            // 百分比即段长;dashoffset 25 = 12 点起笔)。展示行沿用 free 语义。
            var mp = r.memory_used_percent
            .sys_mem_used = mp
            var mrest = 100 - mp
            .sys_mem_dash = mp + " " + mrest
            .sys_mem_display = r.memory_free_mb + " / " + r.memory_total_mb + " MB free"
            // 存储:每盘 { drive, pct, free, total }——进度条视图侧用 AutoUI
            // progress 组件(value/max 双端原生,三期弃内联 :style 与分级色)。
            var dl = []
            for d in r.disks {
                dl.push({ drive: d.drive, pct: d.used_percent, free: d.free_gb, total: d.total_gb })
            }
            .disks = dl
            // GPU 名单(修 T12 遗留:gpus 声明后从未填充,面板恒空)。
            var gl = []
            for g in r.gpus {
                gl.push(g)
            }
            .gpus = gl
            // Managed Modules 计数:独立 fetch(原语与 modules_store.Init 同款),
            // file/collection 二分。
            var mr = fetchModulesRaw()
            if mr.ok {
                var mn = modulesCount(mr.text)
                .sys_mod_total = mn
                var files = 0
                var colls = 0
                var i = 0
                loop {
                    if i >= mn {
                        break
                    }
                    var m = moduleAt(mr.text, i)
                    if m.kind == "file" {
                        files = files + 1
                    }
                    if m.kind != "file" {
                        colls = colls + 1
                    }
                    i = i + 1
                }
                .sys_mod_files = files
                .sys_mod_coll = colls
            }
        }
        // T18: 概要页卡片点击 → 模块跳转（sidebar 同款 Select 链）
        // 446 撤绕行 VG16/A1：Collection.Select 回归后同名，须显式限定。
        .SelectModule(mid) -> {
            Modules.Select(mid)
        }
    }
}
