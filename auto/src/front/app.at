// app.at — shared root for BOTH backends (Plan 008 batch 6): vue (regen →
// App.vue, mounted by src/main.ts) and vm (auto run -r vm). Replaces the
// vm-only root (Plan 007) and app_shell.at (Plan 006 form: named classes +
// style block) — one view source per widget, unified style vocabulary.
//
// Conventions per sidebar.at (batch 1): bare store imports + `.store.x`
// references, marker classes (app-layout/content-header/content-body/
// state-msg) are INERT test hooks, neutrals are deterministic hex, accent
// only via `primary`, no fractional spacing, row/col styles always carry
// explicit flex + gap.
//
// gap-[0px] (2026-08-27 像素对拍): row/col 会被 vue codegen 无条件注入
// `gap-4`，而 Tailwind CSS 里 .gap-4 排在 .gap-0 之后 → 源码 gap-0 必输。
// 任意值形式（gap-[0px]/gap-[10px]…）排在 scale 值之后，稳定获胜。
// 状态文案包一层 flex-1 居中 col（css-era .state-msg 是 height:100% 居中）。
//
// The `key:` on each content child forces a fresh instance per module on
// vue so per-module state (editor drafts) rebinds on switch — the trick the
// hand-written shell used (Plan 006). vm child widgets have no auto-Init,
// so the Load button (batch 3) covers the reload path there.
use modules_store: Modules
use sidebar: Sidebar
use daemon_view: DaemonView
use config_editor: ConfigEditor
use collection_browser: CollectionBrowser
use theme_store: Theme

widget App {
    msg Msg { Init, SelectModule(str) }

    view {
        row (style: "app-layout h-full w-full flex flex-row gap-[0px]") {
            Sidebar { }
            col (style: "flex-1 flex flex-col gap-[0px]") {
                row (style: "content-header h-[48px] w-full shrink-0 flex flex-row items-center gap-[0px] px-6 border-b border-[#e0e0e0] bg-white") {
                    text (text: .store.title, style: "text-xl font-semibold text-[#1a1a1a]") {}
                }
                col (style: "content-body flex-1 flex flex-col gap-[0px] overflow-auto p-6 bg-white") {
                    if .store.loading {
                        col (style: "state-msg flex-1 flex flex-col items-center justify-center gap-[0px]") {
                            text (text: "Loading configuration...", style: "text-base text-[#8a8a8a]") {}
                        }
                    }
                    if .store.loading == false && .store.error != "" {
                        col (style: "state-msg error flex-1 flex flex-col items-center justify-center gap-[0px]") {
                            text (text: "⚠️ " + .store.error, style: "text-base text-[#c42b1c]") {}
                        }
                    }
                    if .store.loading == false && .store.error == "" {
                        if .store.active_kind == "" {
                            // T18: 默认落地页 = 系统概要(方案 A)——模块入口卡片替代
                            // 空白提示。卡片模式与侧栏 nav 同款(vm row/text-prop 词汇)。
                            col (style: "overview flex-1 flex flex-col gap-[0px] overflow-auto p-8 bg-white") {
                                text (text: "System Overview", style: "text-2xl font-semibold text-[#1a1a1a]") {}
                                text (text: "Pick a module below to jump straight into its settings.", style: "text-sm text-[#616161] pb-4") {}
                                for m in .store.view_standalone {
                                    button (class: "overview-card w-full text-left flex items-start gap-3 px-4 py-3 rounded-lg border border-[#e0e0e0] bg-white hover:bg-[#f5f5f5] text-[#1a1a1a]", key: m.id) {
                                        onclick: .SelectModule(m.id)
                                        row (style: "flex flex-row items-center gap-3 w-full") {
                                            span (text: m.icon, style: "text-2xl shrink-0") {}
                                            col (style: "nav-text flex-1 min-w-0 flex flex-col gap-[0px]") {
                                                text (text: m.name, style: "text-sm font-semibold text-[#1a1a1a]") {}
                                                text (text: m.description, style: "text-xs text-[#616161]") {}
                                            }
                                        }
                                    }
                                }
                                for g in .store.view_groups {
                                    text (text: g.label, style: "text-sm font-semibold text-[#1a1a1a] pt-4 pb-1") {}
                                    for m in g.members {
                                        button (class: "overview-card w-full text-left flex items-start gap-3 px-4 py-3 rounded-lg border border-[#e0e0e0] bg-white hover:bg-[#f5f5f5] text-[#1a1a1a]", key: m.id) {
                                            onclick: .SelectModule(m.id)
                                            row (style: "flex flex-row items-center gap-3 w-full") {
                                                span (text: m.icon, style: "text-2xl shrink-0") {}
                                                col (style: "nav-text flex-1 min-w-0 flex flex-col gap-[0px]") {
                                                    text (text: m.name, style: "text-sm font-semibold text-[#1a1a1a]") {}
                                                    text (text: m.description, style: "text-xs text-[#616161]") {}
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if .store.active_kind == "file" {
                            if .store.active_id == "ai-daemon" {
                                DaemonView(module_id: .store.active_id, key: .store.active_id) { }
                                ConfigEditor(module_id: .store.active_id, key: "aaid-cfg") { }
                            }
                            if .store.active_id != "ai-daemon" {
                                ConfigEditor(module_id: .store.active_id, key: .store.active_id) { }
                            }
                        }
                        if .store.active_kind == "collection" {
                            CollectionBrowser(module_id: .store.active_id, read_only: .store.read_only, key: .store.active_id) { }
                        }
                        if .store.active_kind != "" && .store.active_kind != "file" && .store.active_kind != "collection" {
                            col (style: "state-msg flex-1 flex flex-col items-center justify-center gap-[0px]") {
                                text (text: "Custom remote modules were removed in Plan 006 (createComponent(Vue) protocol retired).", style: "text-base text-[#8a8a8a]") {}
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            // plan446 批二 A1:App 同持 Modules+Theme 两 store,裸 store.Init 现歧义报错;
            // 旧 codegen 里 store 即首个 use(Modules),显式限定语义不变。
            Modules.Init()
            // plan010: vm 轨无 auto-Init——accent 从 autoos-ui.json 读回需在根
            // Init 链上显式触发（vue 端 useTheme onMounted 同源，幂等）。
            Theme.Init()
        }
        // T18: 概要页卡片点击 → 模块跳转（sidebar 同款 Select 链）
        .SelectModule(mid) -> {
            store.Select(mid)
        }
    }
}
