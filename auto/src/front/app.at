// app.at — Plan 007 Phase 2 vm harness (TEMPORARY; placeholder restored after).
use back.api: fetchConfigSafe, putConfigSafe, bodyEntries, cfgProvider, loadEnum, tableCols, tableCells, setCell, testDaemon, filterEntities, setBodyField, loadAccent
use modules_store: Modules
use collection_store: Collection

widget App {
    model {
        var t1 str = "-"
        var t2 str = "-"
        var t3 str = "-"
        var t4 str = "-"
        var t5 str = "-"
        var t6 str = "-"
        var t7 str = "-"
        var t8 str = "-"
    }
    view {
        scroll (style: "p-6 gap-3") {
            col (style: "gap-3") {
                button (text: "1g groups") { onclick: .T1g }
                button (text: "1h nested") { onclick: .T1h }
                button (text: "1 modules store") { onclick: .T1 }
                text (text: .t1) {}
                button (text: "10 entryAt") { onclick: .T10 }
                button (text: "9 selectinfo") { onclick: .T9 }
                button (text: "2b init only") { onclick: .T2b }
                button (text: "2 select module") { onclick: .T2 }
                text (text: .t2) {}
                button (text: "3 collection list") { onclick: .T3 }
                text (text: .t3) {}
                button (text: "4 config fetch+entries") { onclick: .T4 }
                text (text: .t4) {}
                button (text: "5 edit+save roundtrip") { onclick: .T5 }
                text (text: .t5) {}
                button (text: "6 table ops") { onclick: .T6 }
                text (text: .t6) {}
                button (text: "7 enum+testdaemon") { onclick: .T7 }
                text (text: .t7) {}
                button (text: "8 theme") { onclick: .T8 }
                text (text: .t8) {}
            }
        }
    }
    on {
        .T1g -> {
            let r = probeG1()
            .t1 = r.step + " ngroups=" + r.ngroups.to_string() + " nlabels=" + r.nlabels.to_string()
        }
        .T1h -> {
            let r = probeG2()
            .t1 = r.step + " data-ok"
        }
        .T1 -> {
            store.Init()
            let mods = store.modules
            .t1 = "err=" + store.error + " n=" + mods.len().to_string() + " title=" + store.title
        }
        .T9 -> {
            let r = fetchModulesViewSafe()
            var out = "ok=" + r.ok.to_string()
            if r.ok {
                let flat = fetch_mods_flat()
                let n = arr_len(flat)
                let fid2 = first_id(flat)
                out = out + " flatn=" + n.to_string() + " flatfid=" + fid2 + " "
                let fid = first_id(r.data.modules)
                let si = select_info(r.data.modules, "roles")
                out = out + " n=" + n.to_string() + " fid=" + fid + " found=" + si.found.to_string()
            }
            .t2 = out
        }
        .T10 -> {
            let r = fetchConfigSafe("ai-daemon")
            var out = "ok=" + r.ok.to_string()
            if r.ok {
                let e0 = entry_at2(r.value, 0)
                let e1 = entry_at2(r.value, 1)
                out = out + " e0=" + e0.k + "/" + e0.ckind + "/" + e0.d + " e1=" + e1.k + "/" + e1.ckind
            }
            .t2 = out
        }
        .T2b -> {
            store.Init()
            .t2 = "init-done"
        }
        .T2 -> {
            store.Select("roles")
            .t2 = "kind=" + store.active_kind + " ro=" + store.read_only.to_string() + " title=" + store.title
        }
        .T3 -> {
            store.Init("roles")
            let list = store.list
            .t3 = "n=" + list.len().to_string()
        }
        .T4 -> {
            let r = fetchConfigSafe("ai-daemon")
            var n = -1
            var prov = ""
            if r.ok {
                let es = bodyEntries(r.value, "ai-daemon")
                n = es.len()
                prov = cfgProvider(r.value)
            }
            .t4 = "ok=" + r.ok.to_string() + " entries=" + n.to_string() + " prov=" + prov
        }
        .T5 -> {
            let r = fetchConfigSafe("ai-daemon")
            var out = "?"
            if r.ok {
                out = "value_type=" + json.type_of(r.value)
            }
            .t5 = out
        }
        .T6 -> {
            let r = fetchConfigSafe("auto-musk")
            var out = "?"
            if r.ok {
                let es = bodyEntries(r.value, "auto-musk")
                out = "entries=" + es.len().to_string()
                let opts = loadEnum("http://127.0.0.1:17701/api/enums/tiers")
                out = out + " tiers=" + opts.len().to_string()
                let td = testDaemon()
                out = out + " daemon=" + td.status
            }
            .t6 = out
        }
        .T7 -> {
            let td = testDaemon()
            .t7 = "status=" + td.status + " err=" + td.error
        }
        .T8 -> {
            let cur = loadAccent()
            applyAccent("coral")
            let again = loadAccent()
            .t8 = "load=" + cur + " afterApply=" + again
        }
    }
}
