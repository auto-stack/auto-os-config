// smoke_panel.at — Phase 0b pipeline smoke test: a child widget referenced
// from AppShell to verify cross-widget codegen imports. Removed in Phase 2.
widget SmokePanel {
    msg Msg { Ping }

    model { var n int = 0 }

    view {
        div {
            class: "smoke"
            text f"smoke ${.n}"
            button "ping" { onclick: .Ping }
        }
    }

    on {
        .Ping -> { .n = .n + 1 }
    }
}
