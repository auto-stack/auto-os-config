// modules_store.at — module registry + selection state (Plan 006 Phase 2).
// Port of composables/useModules.ts. The remote `custom` dispatch is REMOVED
// (Plan 006 §1: protocol retired; custom renders a placeholder in the shell).
//
// State is precomputed for the view (D4): groups carry their member module
// objects; `title` is the active module's display name. All mutations are
// whole-replace (D5). Helpers live in src/lib/api.ts — module-level fns in a
// store file get their params emitted as refs (broken), and `view` is a
// reserved property name that silently eats an access chain (r.view.x → .x).
use back.api: fetchModulesViewSafe, getHash, expandGroupFor

store Modules {
    model {
        var modules Array<str> = []
        // [{ id, label, members: [module...] }] — derived on load
        var groups Array<str> = []
        var standalone Array<str> = []
        var expanded Array<str> = []
        var active_id ?str = None
        // "file" | "collection" | "custom" | "" (no selection)
        var active_kind str = ""
        var read_only bool = false
        var loading bool = false
        var error str = ""
        var title str = "AutoOS Settings"
    }

    msg Msg { Init, Select(str), ToggleGroup(str) }

    on {
        .Init -> {
            .loading = true
            .error = ""
            var r = fetchModulesViewSafe()
            if r.ok {
                .modules = r.data.modules
                .groups = r.data.groups
                .standalone = r.data.standalone
                if .expanded.len() == 0 && r.data.firstGroup != "" {
                    .expanded = [r.data.firstGroup]
                }
                // Deep-link: #module-id auto-selects when valid.
                var h = getHash()
                if h != "" {
                    var m = .modules.find(x => x.id == h)
                    if m != nil {
                        .active_id = m.id
                        .active_kind = m.kind
                        .read_only = m.format == "frontmatter-md"
                        .title = m.name
                        .expanded = expandGroupFor(.expanded, .groups, h)
                    }
                }
            }
            if r.ok == false {
                .error = r.error
                .modules = []
                .groups = []
                .standalone = []
            }
            .loading = false
        }

        .Select(id) -> {
            var m = .modules.find(x => x.id == id)
            if m != nil {
                .active_id = m.id
                .active_kind = m.kind
                .read_only = m.format == "frontmatter-md"
                .title = m.name
                .expanded = expandGroupFor(.expanded, .groups, id)
            }
        }

        .ToggleGroup(gid) -> {
            if .expanded.includes(gid) {
                .expanded = .expanded.filter(x => x != gid)
            }
            if .expanded.includes(gid) == false {
                .expanded = .expanded.concat([gid])
            }
        }
    }
}
