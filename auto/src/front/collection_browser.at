// collection_browser.at — the unified master-detail collection browser
// (Plan 008 Phase 3 batch 4). ONE view source for BOTH backends, replacing
// the vue named-class browser + ScalarFields/TableField children (Plan 006)
// and vm_collection.at (Plan 007).
//
// vm-proven patterns (007 gate): entity rows loop the store's parallel
// `view_names` string array (filter projection — field access on store-list
// loop vars in event args kills the MCP channel); field rows use INDEX event
// args resolved against the parallel `entry_keys`; store calls accept map
// literals ({path, value}); selection state is a bool (`has_selection`) —
// nil-compare semantics diverge across backends. `.Init` auto-fires on vue
// mount (list auto-loads); on vm the Load button kicks it (same shape as
// the unified config editor).
//
// Registered deviations (D7): no per-entity description line in the list;
// delete confirm is an inline row (no modal); select renders as free text +
// hint; tables render as readonly JSON; sidecar is a plain textarea. The
// 8-control dispatch mirrors config_editor.at (vm props are scalar-only, so
// no shared child widget is possible). Markers (list-pane/e-name/mono/
// dirty/field-label…) are inert test hooks.
use collection_store: Collection
use back.api: fieldDisplayOf

widget CollectionBrowser(module_id: str, read_only: bool) {
    msg Msg {
        Init,
        Load,
        SetFilter(str),
        ToggleCreate,
        NewName(str),
        DoCreate,
        CancelCreate,
        Pick(str),
        Reload,
        Save,
        AskDelete,
        ConfirmDeleteYes,
        ConfirmDeleteNo,
        Draft(str),
        SidecarDraft(str),
        ApplyEntry(str),
        TagAdd(str),
        Toggle(str),
        PwToggle
    }

    model {
        var creating bool = false
        var new_name str = ""
        var confirm_open bool = false
        var draft str = ""
        var sidecar_draft str = ""
        var pw_show bool = false
    }

    view {
        row (style: "collection gap-4 max-w-[960px]") {
            col (style: "list-pane w-[260px] shrink-0 border border-[#e0e0e0] rounded-lg bg-white") {
                row (style: "list-head gap-2 p-2 border-b border-[#e0e0e0]") {
                    input (placeholder: "Filter…", value: .store.name_filter, style: "filter-input flex-1 px-2 py-1 text-xs border border-[#e0e0e0] rounded bg-[#f0f0f0]") {
                        oninput: .SetFilter
                    }
                    if read_only == false {
                        button (text: "＋", style: "px-2 py-1 text-sm rounded border border-[#e0e0e0] bg-white") {
                            onclick: .ToggleCreate
                        }
                    }
                }
                if .creating {
                    row (style: "create-row gap-2 p-2 border-b border-[#e0e0e0] bg-[#ededed]") {
                        input (placeholder: "entity-name", value: .new_name, style: "name-input flex-1 px-2 py-1 text-xs border border-[#e0e0e0] rounded bg-white font-mono") {
                            oninput: .NewName
                        }
                        button (text: "Add", style: "px-2 py-1 text-xs rounded border border-[#e0e0e0] bg-white") {
                            onclick: .DoCreate
                        }
                        button (text: "✕", style: "px-2 py-1 text-xs rounded border border-[#e0e0e0] bg-white") {
                            onclick: .CancelCreate
                        }
                    }
                }
                if .store.list_loading {
                    text (text: "Loading…", style: "list-msg p-4 text-center text-xs text-[#8a8a8a]") {}
                }
                if .store.list_loading == false {
                    if .store.view_names.len() == 0 {
                        text (text: "No entities.", style: "list-msg p-4 text-center text-xs text-[#8a8a8a]") {}
                    }
                    if .store.names.len() == 0 {
                        if read_only == false {
                            button (text: "Load", style: "mx-2 px-3 py-1 text-xs rounded border border-[#e0e0e0] bg-white") {
                                onclick: .Load
                            }
                        }
                    }
                    if .store.names.len() > 0 {
                        if .store.view_names.len() == 0 {
                            text (text: "No match.", style: "list-msg p-2 text-center text-xs text-[#8a8a8a]") {}
                        }
                    }
                    scroll (style: "max-h-[70vh] p-1") {
                        col (style: "entity-list gap-[2px]") {
                            for n in .store.view_names {
                                div (class: "contents") {
                                    key: n
                                    // Rule 6: NO if-expression styles on interactive
                                    // elements (vm hoists props to a wrapper and the
                                    // event arg goes unbound) — block-if with two
                                    // statically-styled buttons instead.
                                    if .store.selected_name == n {
                                        button (text: n, style: "e-item e-name active w-full text-left px-[10px] py-[7px] rounded font-mono text-sm bg-primary/10 text-primary font-semibold") {
                                            onclick: .Pick(n)
                                        }
                                    }
                                    if .store.selected_name != n {
                                        button (text: n, style: "e-item e-name w-full text-left px-[10px] py-[7px] rounded font-mono text-sm text-[#1a1a1a]") {
                                            onclick: .Pick(n)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            col (style: "detail-pane flex-1") {
                if .store.selected_name == nil {
                    if .store.error != "" {
                        text (text: "✗ " + .store.error, style: "state-msg error px-4 py-3 rounded-lg text-sm text-[#c42b1c]") {}
                    }
                    if .store.error == "" {
                        text (text: "Select an entity from the left, or create a new one.", style: "state-msg px-4 py-3 rounded-lg bg-[#ededed] text-sm text-[#616161]") {}
                    }
                }
                if .store.selected_name != nil && .store.loading {
                    text (text: "Loading…", style: "state-msg px-4 py-3 rounded-lg bg-[#ededed] text-sm text-[#616161]") {}
                }
                if .store.selected_name != nil && .store.loading == false {
                        row (style: "toolbar flex items-center gap-3 py-2 border-b border-[#e0e0e0]") {
                            text (text: .store.selected_name, style: "mono font-mono text-sm font-semibold text-[#1a1a1a]") {}
                            if .store.dirty {
                                text (text: "● unsaved", style: "dirty text-xs font-medium text-primary") {}
                            }
                            if .store.is_read_only {
                                text (text: "read-only", style: "ro-badge text-[11px] px-2 rounded-full bg-[#ededed] text-[#616161]") {}
                            }
                            div (style: "flex-1") {}
                            if read_only == false && .store.is_read_only == false {
                                button (text: "Reload", style: "px-3 py-1 text-xs rounded border border-[#e0e0e0] bg-white") {
                                    onclick: .Reload
                                }
                                button (text: "Save", style: "px-4 py-1 text-xs rounded bg-primary border-primary text-white") {
                                    onclick: .Save
                                }
                                button (text: "Delete", style: "px-3 py-1 text-xs rounded border border-[#c42b1c] text-[#c42b1c] bg-white") {
                                    onclick: .AskDelete
                                }
                            }
                        }
                        if .confirm_open {
                            row (style: "flex items-center gap-3 px-3 py-2 border border-[#c42b1c] rounded bg-[#ededed]") {
                                text (text: "Delete this entity? (.at + sidecar removed, .bak kept)", style: "text-sm text-[#c42b1c]") {}
                                div (style: "flex-1") {}
                                button (text: "Yes, delete", style: "px-3 py-1 text-xs rounded bg-[#c42b1c] border-[#c42b1c] text-white") {
                                    onclick: .ConfirmDeleteYes
                                }
                                button (text: "Cancel", style: "px-3 py-1 text-xs rounded border border-[#e0e0e0] bg-white") {
                                    onclick: .ConfirmDeleteNo
                                }
                            }
                        }
                        if .store.error != "" {
                            text (text: "✗ " + .store.error, style: "state-msg error px-4 py-3 rounded-lg text-sm text-[#c42b1c]") {}
                        }
                        if .store.is_read_only {
                            col (style: "fm-view gap-2") {
                                text (text: .store.fm_name, style: "text-lg font-bold text-[#1a1a1a]") {}
                                text (text: .store.fm_description, style: "text-sm text-[#616161]") {}
                                text (text: .store.fm_body, style: "skill-body fm-body p-3 rounded-lg bg-[#ededed] font-mono text-xs text-[#616161]") {}
                            }
                        }
                        if .store.is_read_only == false {
                            // vm: loops need a scrollable ancestor (iced drops
                            // unbounded loop content in plain cols — J1 root cause)
                            scroll (style: "flex-1") {
                            col (style: "fields gap-1") {
                                // PROBE removed (moved to detail-pane top)
                                // vm: 007-proven loop form (J1/J2 workaround 2026-08-26) —
                                // double-var loop + keyed `contents` wrapper; events carry the
                                // INDEX i (field access on loop vars in event args kills the vm
                                // channel); handlers resolve i → key via parallel store.entry_keys.
                                for i, e in .store.entries {
                                    div (class: "contents") {
                                        key: e.key
                                    if e.is_table {
                                            col (style: "field-row border rounded p-2 gap-1 bg-white") {
                                                    text (text: e.label, style: "field-label text-sm font-medium text-[#616161]") {}
                                                    text (text: e.frag, style: "text-xs text-[#8a8a8a] font-mono") {}
                                            }
                                    }
                                    if e.kind == "toggle" {
                                            row (style: "field-row flex items-center gap-3 py-2") {
                                                    text (text: e.label, style: "field-label text-sm font-medium text-[#616161] w-[160px] shrink-0") {}
                                                    checkbox (id: e.key, checked: e.value) {
                                                        onclick: .Toggle(i)
                                                    }
                                                    if e.value == "true" {
                                                        text (text: "On", style: "text-xs text-[#616161]") {}
                                                    }
                                                    if e.value != "true" {
                                                        text (text: "Off", style: "text-xs text-[#8a8a8a]") {}
                                                    }
                                            }
                                    }
                                    if e.kind == "number" {
                                            row (style: "field-row flex items-center gap-3 py-2") {
                                                    text (text: e.label, style: "field-label text-sm font-medium text-[#616161] w-[160px] shrink-0") {}
                                                    input (placeholder: e.label, "type": "number", value: e.value, style: "input px-[10px] py-[6px] text-sm border border-[#e0e0e0] rounded bg-white w-[240px]") {
                                                        oninput: .Draft
                                                    }
                                                    button (text: "Apply", style: "btn px-3 py-1 text-xs rounded border border-[#e0e0e0] bg-white") {
                                                        onclick: .ApplyEntry(i)
                                                    }
                                            }
                                    }
                                    if e.kind == "password" {
                                            row (style: "field-row flex items-center gap-3 py-2") {
                                                    text (text: e.label, style: "field-label text-sm font-medium text-[#616161] w-[160px] shrink-0") {}
                                                    if .pw_show {
                                                                                                                input (placeholder: e.label, value: e.value, style: "input px-[10px] py-[6px] text-sm border border-[#e0e0e0] rounded bg-white w-[240px]") {
                                                            oninput: .Draft
                                                        }
                                                    }
                                                    if .pw_show == false {
                                                                                                                input (placeholder: e.label, "type": "password", value: e.value, style: "input px-[10px] py-[6px] text-sm border border-[#e0e0e0] rounded bg-white w-[240px]") {
                                                            oninput: .Draft
                                                        }
                                                    }
                                                    button (text: "👁", style: "btn px-2 py-1 text-xs rounded border border-[#e0e0e0] bg-white") {
                                                        onclick: .PwToggle
                                                    }
                                                    button (text: "Apply", style: "btn px-3 py-1 text-xs rounded border border-[#e0e0e0] bg-white") {
                                                        onclick: .ApplyEntry(i)
                                                    }
                                            }
                                    }
                                    if e.kind == "text" {
                                            row (style: "field-row flex items-center gap-3 py-2") {
                                                    text (text: e.label, style: "field-label text-sm font-medium text-[#616161] w-[160px] shrink-0") {}
                                                    input (placeholder: e.label, value: e.value, style: "input px-[10px] py-[6px] text-sm border border-[#e0e0e0] rounded bg-white w-[240px]") {
                                                        oninput: .Draft
                                                    }
                                                    button (text: "Apply", style: "btn px-3 py-1 text-xs rounded border border-[#e0e0e0] bg-white") {
                                                        onclick: .ApplyEntry(i)
                                                    }
                                            }
                                    }
                                    if e.kind == "select" {
                                            col (style: "field-row py-2 gap-1") {
                                                    row (style: "flex items-center gap-3") {
                                                        text (text: e.label, style: "field-label text-sm font-medium text-[#616161] w-[160px] shrink-0") {}
                                                        input (placeholder: e.label, value: e.value, style: "input px-[10px] py-[6px] text-sm border border-[#e0e0e0] rounded bg-white w-[240px]") {
                                                            oninput: .Draft
                                                        }
                                                        button (text: "Apply", style: "btn px-3 py-1 text-xs rounded border border-[#e0e0e0] bg-white") {
                                                            onclick: .ApplyEntry(i)
                                                        }
                                                    }
                                                    if e.url != "" {
                                                        text (text: "(select — free text accepted)", style: "text-xs text-[#8a8a8a]") {}
                                                    }
                                            }
                                    }
                                    if e.kind == "tags" {
                                            col (style: "field-row py-2 gap-1") {
                                                    row (style: "flex items-center gap-3") {
                                                        text (text: e.label, style: "field-label text-sm font-medium text-[#616161] w-[160px] shrink-0") {}
                                                        input (placeholder: "add value", value: e.value, style: "input px-[10px] py-[6px] text-sm border border-[#e0e0e0] rounded bg-white w-[240px]") {
                                                            oninput: .Draft
                                                        }
                                                        button (text: "Add", style: "btn px-3 py-1 text-xs rounded border border-[#e0e0e0] bg-white") {
                                                            onclick: .TagAdd(i)
                                                        }
                                                    }
                                                    text (text: e.value, style: "text-xs text-[#8a8a8a] font-mono") {}
                                            }
                                    }
                                    if e.kind == "multiselect" {
                                            col (style: "field-row py-2 gap-1") {
                                                    row (style: "flex items-center gap-3") {
                                                        text (text: e.label, style: "field-label text-sm font-medium text-[#616161] w-[160px] shrink-0") {}
                                                        input (placeholder: "add value", value: e.value, style: "input px-[10px] py-[6px] text-sm border border-[#e0e0e0] rounded bg-white w-[240px]") {
                                                            oninput: .Draft
                                                        }
                                                        button (text: "Add", style: "btn px-3 py-1 text-xs rounded border border-[#e0e0e0] bg-white") {
                                                            onclick: .TagAdd(i)
                                                        }
                                                    }
                                                    text (text: e.value, style: "text-xs text-[#8a8a8a] font-mono") {}
                                            }
                                    }
                                    if e.kind == "subform" {
                                            col (style: "field-row border rounded p-2 gap-1 bg-white") {
                                                    text (text: e.label, style: "field-label text-sm font-medium text-[#616161]") {}
                                                    text (text: e.frag, style: "text-xs text-[#8a8a8a] font-mono") {}
                                            }
                                    }
                                    }
                                }

                                col (style: "field-row sidecar-row py-2 gap-1") {
                                    text (text: "Soul (markdown sidecar)", style: "field-label text-sm font-medium text-[#616161]") {}
                                    textarea (placeholder: "# Soul — the role's system prompt / personality (markdown).", value: .sidecar_draft, style: "sidecar w-full min-h-[160px] p-2 text-xs border border-[#e0e0e0] rounded bg-white font-mono") {
                                        oninput: .SidecarDraft
                                    }
                                }
                            }
                            }
                        }
                }
            }
        }
    }

    on {
        .Init -> {
            store.Open(.module_id)
        }
        .Load -> {
            store.Open(.module_id)
        }
        .SetFilter(q) -> {
            store.SetFilter(q)
        }
        .ToggleCreate -> {
            .creating = .creating == false
        }
        .NewName(v str) -> {
            .new_name = v
        }
        .DoCreate -> {
            var name = .new_name.trim()
            if name != "" {
                store.NewEntity(name)
                .creating = false
                .new_name = ""
            }
        }
        .CancelCreate -> {
            .creating = false
            .new_name = ""
        }
        .Pick(n) -> {
            store.Pick(n)
            .sidecar_draft = .store.sidecar
            .draft = ""
        }
        .Reload -> {
            store.Reload()
        }
        .Save -> {
            store.SetSidecar(.sidecar_draft)
            store.SaveEntity()
        }
        .AskDelete -> {
            .confirm_open = true
        }
        .ConfirmDeleteYes -> {
            .confirm_open = false
            store.DelEntity(.store.selected_name)
        }
        .ConfirmDeleteNo -> {
            .confirm_open = false
        }
        .Draft(v str) -> {
            .draft = v
        }
        .SidecarDraft(v str) -> {
            .sidecar_draft = v
        }
        .PwToggle -> {
            .pw_show = .pw_show == false
        }
        .ApplyEntry(i) -> {
            var k = ""
            var j = 0
            for x in .store.entry_keys {
                if j == i {
                    k = x
                }
                j = j + 1
            }
            if .draft != "" && k != "" {
                store.FieldEdited({ path: k, value: .draft })
                .draft = ""
            }
        }

        .TagAdd(i) -> {
            var k = ""
            var j = 0
            for x in .store.entry_keys {
                if j == i {
                    k = x
                }
                j = j + 1
            }
            if .draft != "" && k != "" {
                store.TagField(k, .draft)
                .draft = ""
            }
        }

        .Toggle(i) -> {
            var k = ""
            var j = 0
            for x in .store.entry_keys {
                if j == i {
                    k = x
                }
                j = j + 1
            }
            var nv = "false"
            if k != "" {
                let cur = fieldDisplayOf(.store.body_text, k)
                if cur == "false" || cur == "" {
                    nv = "true"
                }
            }
            store.FieldEdited({ path: k, value: nv })
        }
    }
}
