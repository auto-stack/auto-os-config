// collection_browser.at — the unified master-detail collection browser
// (Plan 008 Phase 3 batch 4). ONE view source for BOTH backends, replacing
// the vue named-class browser + ScalarFields/TableField children (Plan 006)
// and vm_collection.at (Plan 007).
//
// vm-proven patterns (007 gate; 446 撤绕行 B1 更新): entity/field rows loop
// store object lists and pass loop-var fields (e.name / e.key) as event args
// directly — the parallel `view_names`/`entry_keys` shadow arrays are gone;
// store calls accept map literals ({path, value});
// nil-compare semantics diverge across backends. `.Init` auto-fires on vue
// mount (list auto-loads); on vm the Load button kicks it (same shape as
// the unified config editor).
//
// Registered deviations (D7): no per-entity description line in the list;
// delete confirm is an inline row (no modal); select renders as free text +
// hint; tables render as readonly JSON; sidecar is a plain textarea. The
// 8-control dispatch mirrors config_editor.at (vm props are scalar-only, so
// no shared child widget is possible). Markers (list-pane/e-name/mono/
// dirty/field-label…) are inert test hooks.
use collection_store: Collection
use back.api: fieldDisplayOf, setCellText, tableAddRowText, tableRemoveRowText

widget CollectionBrowser(module_id: str, read_only: bool) {
    msg Msg {
        Init,
        Load,
        SetFilter(str),
        ToggleCreate,
        NewName(str),
        DoCreate,
        CancelCreate,
        Pick(str),
        Reload,
        Save,
        AskDelete,
        ConfirmDeleteYes,
        ConfirmDeleteNo,
        Draft(str),
        SidecarDraft(str),
        ApplyEntry(str, str),
        TagAdd(str),
        TagRemove(str, str),
        MsToggle(str, str, bool),
        Toggle(str, bool),
        TableCell(str, int, str, str),
        TableRowAdd(str),
        TableRowRemove(str, int),
        PwToggle
    }

    model {
        var creating bool = false
        var new_name str = ""
        var confirm_open bool = false
        var draft str = ""
        var sidecar_draft str = ""
        var pw_show bool = false
    }

    view {
        row (style: "collection gap-[16px] max-w-[960px]") {
            aside (style: "list-pane gap-[0px]") {
                div (style: "list-head gap-[6px]") {
                    input (placeholder: "Filter…", value: .store.name_filter, style: "filter-input") {
                        oninput: .SetFilter
                    }
                    if read_only == false {
                        button (text: "+", style: "btn icon bg-white border border-[#e0e0e0] rounded px-[10px] py-1 text-base text-[#1a1a1a] h-auto") {
                            onclick: .ToggleCreate
                        }
                    }
                }
                if .creating {
                    div (style: "create-row gap-[4px]") {
                        input (placeholder: "entity-name", value: .new_name, style: "name-input") {
                            oninput: .NewName
                            onkeydown.enter: .DoCreate
                        }
                        button (text: "Add", style: "btn small bg-white border border-[#e0e0e0] rounded px-[10px] py-1 text-xs text-[#1a1a1a] h-auto", disabled: .store.saving || .new_name.trim() == "") {
                            onclick: .DoCreate
                        }
                        button (text: "✕", style: "btn small bg-white border border-[#e0e0e0] rounded px-[10px] py-1 text-xs text-[#1a1a1a] h-auto") {
                            onclick: .CancelCreate
                        }
                    }
                }
                if .store.list_loading {
                    div (style: "list-msg") {
                        text (text: "Loading…") {}
                    }
                }
                if .store.list_loading == false {
                    if .store.view_entities.len() == 0 {
                        if .store.list.len() == 0 {
                            div (style: "list-msg empty") {
                                text (text: "No entities.") {}
                            }
                        }
                        if .store.list.len() > 0 {
                            div (style: "list-msg empty") {
                                text (text: "No match.") {}
                            }
                        }
                        if read_only == false {
                            button (text: "Load", style: "btn small list-load") {
                                onclick: .Load
                            }
                        }
                    }
                    if .store.view_entities.len() > 0 {
                        div (style: "entity-list gap-[0px]") {
                            for e in .store.view_entities {
                                div (style: "contents") {
                                    key: e.name
                                    if .store.selected_name == e.name {
                                        button (style: "e-row active") {
                                            onclick: .Pick(e.name)
                                            span (style: "e-name", text: e.name) {}
                                            if e.description != "" {
                                                span (style: "e-desc", text: e.description) {}
                                            }
                                        }
                                    }
                                    if .store.selected_name != e.name {
                                        button (style: "e-row") {
                                            onclick: .Pick(e.name)
                                            span (style: "e-name", text: e.name) {}
                                            if e.description != "" {
                                                span (style: "e-desc", text: e.description) {}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            section (style: "detail-pane gap-[0px]") {
                if .store.selected_name == nil {
                    if .store.error != "" {
                        div (style: "state-msg error") {
                            text (text: "✗ " + .store.error) {}
                        }
                    }
                    if .store.error == "" {
                        div (style: "state-msg") {
                            text (text: "Select an entity from the left, or create a new one.") {}
                        }
                    }
                }
                if .store.selected_name != nil && .store.loading {
                    div (style: "state-msg") {
                        text (text: "Loading…") {}
                    }
                }
                if .store.selected_name != nil && .store.loading == false {
                    div (style: "toolbar gap-[0px]") {
                        div (style: "meta gap-[0px]") {
                            span (style: "mono", text: .store.selected_name) {}
                            if .store.dirty {
                                span (style: "dirty", text: "● unsaved") {}
                            }
                            if .store.is_read_only {
                                span (style: "ro-badge", text: "read-only") {}
                            }
                        }
                        div (style: "actions gap-[0px]") {
                            if read_only == false && .store.is_read_only == false {
                                button (text: "Reload", style: "btn bg-white border border-[#e0e0e0] rounded px-[14px] py-[5px] text-xs text-[#1a1a1a] h-auto", disabled: .store.saving) {
                                    onclick: .Reload
                                }
                                button (style: "btn primary", disabled: .store.saving || .store.dirty == false) {
                                    onclick: .Save
                                    if .store.saving {
                                        text (text: "Saving…") {}
                                    }
                                    if .store.saving == false {
                                        text (text: "Save") {}
                                    }
                                }
                                button (text: "Delete", style: "btn danger bg-[#c42b1c] text-white border-[#c42b1c] h-auto") {
                                    onclick: .AskDelete
                                }
                            }
                        }
                    }
                    // 446 撤绕行 C1：确认层迁回 popover（上游 plan446_c1_popover
                    // 常驻锁形态：点锚 + ondismiss + class 面板），if 块模拟弹层已删。
                    popover (open: .confirm_open, x: 620.0, y: 300.0, ondismiss: .ConfirmDeleteNo, class: "w-72 bg-white border border-[#e0e0e0] rounded-lg p-4 gap-2") {
                        p {
                            text (text: "Delete ") {}
                            span (style: "strong", text: .store.selected_name) {}
                            text (text: "?") {}
                        }
                        p (style: "modal-hint") {
                            text (text: "This removes the ") {}
                            span (style: "inline-code", text: ".at") {}
                            text (text: " file and its sidecar. A ") {}
                            span (style: "inline-code", text: ".bak") {}
                            text (text: " is kept.") {}
                        }
                        div (style: "modal-actions gap-[8px]") {
                            button (text: "Cancel", style: "btn bg-white border border-[#e0e0e0] rounded px-[14px] py-[5px] text-xs text-[#1a1a1a] h-auto") {
                                onclick: .ConfirmDeleteNo
                            }
                            button (text: "Delete", style: "btn danger bg-[#c42b1c] text-white border-[#c42b1c] h-auto") {
                                onclick: .ConfirmDeleteYes
                            }
                        }
                    }
                    if .store.error != "" {
                        div (style: "state-msg error") {
                            text (text: "✗ " + .store.error) {}
                        }
                    }
                    if .store.is_read_only {
                        col (style: "fm-view gap-[0px]") {
                            div (style: "field-row") {
                                label (text: "Name", style: "field-label w-[160px] shrink-0 text-xs text-[#616161] pt-[6px] font-medium h-auto") {}
                                div (style: "readonly-val mono") {
                                    text (text: .store.fm_name) {}
                                }
                            }
                            div (style: "field-row") {
                                label (text: "Description", style: "field-label w-[160px] shrink-0 text-xs text-[#616161] pt-[6px] font-medium h-auto") {}
                                div (style: "readonly-val") {
                                    text (text: .store.fm_description) {}
                                }
                            }
                            div (style: "skill-body", text: .store.fm_body) {}
                        }
                    }
                    if .store.is_read_only == false {
                        div (style: "fields gap-[0px]") {
                            for e in .store.entries {
                                div (style: "contents") {
                                    key: e.key
                                    if e.is_table {
                                        div (style: "field-row") {
                                            label (text: e.label, style: "field-label w-[160px] shrink-0 text-xs text-[#616161] pt-[6px] font-medium h-auto") {}
                                            div (style: "table-wrap gap-[0px]") {
                                                table (style: "tbl") {
                                                    thead {
                                                        tr {
                                                            for c in e.t_cols {
                                                                th (text: c.name, style: "bg-[#ededed] text-[#616161] text-xs font-semibold h-auto") {}
                                                            }
                                                            th (style: "row-act") {}
                                                        }
                                                    }
                                                    tbody {
                                                        for ri, r in e.t_rows {
                                                            tr {
                                                                for c in e.t_cols {
                                                                    td {
                                                                        if c.kind == "select" {
                                                                            select (value: r[c.name], style: "cell-select") {
                                                                                onchange: .TableCell(e.key, ri, c.name, $event.target.value)
                                                                                for o in c.options {
                                                                                    option (value: o.value, text: o.label) {}
                                                                                }
                                                                                option (value: r[c.name], text: r[c.name]) {}
                                                                            }
                                                                        }
                                                                        if c.kind == "number" {
                                                                            input (value: r[c.name], "type": "number", style: "cell-input") {
                                                                                onchange: .TableCell(e.key, ri, c.name, $event.target.value)
                                                                            }
                                                                        }
                                                                        if c.kind != "select" && c.kind != "number" {
                                                                            input (value: r[c.name], "type": "text", style: "cell-input") {
                                                                                onchange: .TableCell(e.key, ri, c.name, $event.target.value)
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                                td (style: "row-act") {
                                                                    button (text: "×", style: "del-row") {
                                                                        onclick: .TableRowRemove(e.key, ri)
                                                                    }
                                                                }
                                                            }
                                                        }
                                                        if e.t_rows.len() == 0 {
                                                            tr {
                                                                td (style: "empty", text: "(empty — click + Row)") {}
                                                            }
                                                        }
                                                    }
                                                }
                                                button (text: "+ Row", style: "add-row") {
                                                    onclick: .TableRowAdd(e.key)
                                                }
                                            }
                                        }
                                    }
                                    if e.is_table == false && e.kind == "toggle" {
                                        div (style: "field-row") {
                                            label (text: e.label, style: "field-label w-[160px] shrink-0 text-xs text-[#616161] pt-[6px] font-medium h-auto") {}
                                            label (style: "toggle gap-[0px]") {
                                                input ("type": "checkbox", checked: e.value == "true") {
                                                    onchange: .Toggle(e.key, $event.target.checked)
                                                }
                                                span (style: "toggle-track") {
                                                    span (style: "toggle-thumb") {}
                                                }
                                                span (style: "toggle-text") {
                                                    if e.value == "true" {
                                                        text (text: "On") {}
                                                    }
                                                    if e.value != "true" {
                                                        text (text: "Off") {}
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if e.is_table == false && e.kind == "number" {
                                        div (style: "field-row") {
                                            label (text: e.label, style: "field-label w-[160px] shrink-0 text-xs text-[#616161] pt-[6px] font-medium h-auto") {}
                                            input ("type": "number", value: e.value, style: "input") {
                                                oninput: .Draft
                                                onchange: .ApplyEntry(e.key, $event.target.value)
                                            }
                                        }
                                    }
                                    if e.is_table == false && e.kind == "password" {
                                        div (style: "field-row") {
                                            label (text: e.label, style: "field-label w-[160px] shrink-0 text-xs text-[#616161] pt-[6px] font-medium h-auto") {}
                                            div (style: "secret gap-[0px]") {
                                                if .pw_show {
                                                    input (value: e.value, "type": "text", placeholder: "(not set)", style: "input pw text-[#1a1a1a] h-auto") {
                                                        oninput: .Draft
                                                        onchange: .ApplyEntry(e.key, $event.target.value)
                                                    }
                                                }
                                                if .pw_show == false {
                                                    input (value: e.value, "type": "password", placeholder: "(not set)", style: "input pw text-[#1a1a1a] h-auto") {
                                                        oninput: .Draft
                                                        onchange: .ApplyEntry(e.key, $event.target.value)
                                                    }
                                                }
                                                button (style: "reveal bg-white border border-[#e0e0e0] rounded px-2 py-1 text-sm text-[#1a1a1a] h-auto", text: "👁") {
                                                    onclick: .PwToggle
                                                }
                                            }
                                        }
                                    }
                                    if e.is_table == false && e.kind == "text" {
                                        div (style: "field-row") {
                                            label (text: e.label, style: "field-label w-[160px] shrink-0 text-xs text-[#616161] pt-[6px] font-medium h-auto") {}
                                            input (value: e.value, "type": "text", placeholder: "(empty)", style: "input text-[#1a1a1a] h-auto") {
                                                oninput: .Draft
                                                onchange: .ApplyEntry(e.key, $event.target.value)
                                            }
                                        }
                                    }
                                    if e.is_table == false && e.kind == "select" {
                                        div (style: "field-row") {
                                            label (text: e.label, style: "field-label w-[160px] shrink-0 text-xs text-[#616161] pt-[6px] font-medium h-auto") {}
                                            if e.options.len() > 0 {
                                                select (value: e.value, style: "input") {
                                                    onchange: .ApplyEntry(e.key, $event.target.value)
                                                    for o in e.options {
                                                        option (value: o.value, text: o.label) {}
                                                    }
                                                    if e.has_current {
                                                        option (value: e.value, text: e.value + " (current)") {}
                                                    }
                                                }
                                            }
                                            if e.options.len() == 0 {
                                                div (style: "fallback-text gap-[0px]") {
                                                    input (value: e.value, "type": "text", placeholder: "(not set)", style: "input text-[#1a1a1a] h-auto") {
                                                        oninput: .Draft
                                                        onchange: .ApplyEntry(e.key, $event.target.value)
                                                    }
                                                    span (style: "fallback-hint", text: "no options available (e.g. builtin-only) — type freely") {}
                                                }
                                            }
                                        }
                                    }
                                    if e.is_table == false && e.kind == "tags" {
                                        div (style: "field-row") {
                                            label (text: e.label, style: "field-label w-[160px] shrink-0 text-xs text-[#616161] pt-[6px] font-medium h-auto") {}
                                            div (style: "tags") {
                                                for t in e.items {
                                                    span (style: "tag") {
                                                        text (text: t) {}
                                                        button (text: "×", style: "tag-x") {
                                                            onclick: .TagRemove(e.key, t)
                                                        }
                                                    }
                                                }
                                                input (value: "", "type": "text", placeholder: "add…", style: "tag-input") {
                                                    oninput: .Draft
                                                    onkeydown.enter: .TagAdd(e.key)
                                                }
                                            }
                                        }
                                    }
                                    if e.is_table == false && e.kind == "multiselect" {
                                        div (style: "field-row") {
                                            label (text: e.label, style: "field-label w-[160px] shrink-0 text-xs text-[#616161] pt-[6px] font-medium h-auto") {}
                                            div (style: "multiselect") {
                                                for oi, o in e.options {
                                                    label (style: "ms-item") {
                                                        input ("type": "checkbox", checked: e.ms_checked[oi]) {
                                                            onchange: .MsToggle(e.key, o.value, $event.target.checked)
                                                        }
                                                        text (text: o.label) {}
                                                    }
                                                }
                                                if e.options.len() == 0 {
                                                    p (style: "ms-empty", text: "No options available (directory empty or missing).") {}
                                                }
                                            }
                                        }
                                    }
                                    if e.is_table == false && e.kind == "subform" {
                                        div (style: "field-row") {
                                            label (text: e.label, style: "field-label w-[160px] shrink-0 text-xs text-[#616161] pt-[6px] font-medium h-auto") {}
                                            div (style: "table-readonly") {
                                                text (text: e.frag, style: "font-mono text-xs text-[#616161] whitespace-pre-wrap break-all") {}
                                            }
                                        }
                                    }
                                }
                            }
                            div (style: "field-row sidecar-row") {
                                label (style: "field-label w-[160px] shrink-0 text-xs text-[#616161] pt-[6px] font-medium h-auto") {
                                    text (text: "Soul ") {}
                                    span (style: "hint", text: "(markdown sidecar)") {}
                                }
                                textarea (placeholder: "# Soul — the role's system prompt / personality (markdown).", value: .sidecar_draft, style: "sidecar") {
                                    oninput: .SidecarDraft
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            Collection.Init(.module_id)
        }
        .Load -> {
            Collection.Init(.module_id)
        }
        .SetFilter(q) -> {
            store.SetFilter(q)
        }
        .ToggleCreate -> {
            .creating = .creating == false
        }
        .NewName(v str) -> {
            .new_name = v
        }
        .DoCreate -> {
            var name = .new_name.trim()
            if name != "" {
                store.Create(name)
                .creating = false
                .new_name = ""
            }
        }
        .CancelCreate -> {
            .creating = false
            .new_name = ""
        }
        .Pick(n) -> {
            Collection.Select(n)
            .sidecar_draft = .store.sidecar
            .draft = ""
        }
        .Reload -> {
            store.Reload()
        }
        .Save -> {
            store.SetSidecar(.sidecar_draft)
            store.Save()
        }
        .AskDelete -> {
            .confirm_open = true
        }
        .ConfirmDeleteYes -> {
            .confirm_open = false
            store.Remove(.store.selected_name)
        }
        .ConfirmDeleteNo -> {
            .confirm_open = false
        }
        .Draft(v str) -> {
            .draft = v
        }
        .SidecarDraft(v str) -> {
            .sidecar_draft = v
        }
        .PwToggle -> {
            .pw_show = .pw_show == false
        }
        .ApplyEntry(k, v) -> {
            store.FieldEdited({ path: k, value: v })
            .draft = ""
        }

        .TagAdd(k) -> {
            if .draft != "" {
                store.TagField(k, .draft)
                .draft = ""
            }
        }

        .TagRemove(k, t) -> {
            store.TagRemove(k, t)
        }

        .MsToggle(k, v, on) -> {
            if on {
                store.TagField(k, v)
            }
            if on == false {
                store.TagRemove(k, v)
            }
        }

        .TableCell(k, ri, col, v) -> {
            let nb = setCellText(.store.body_text, k, ri, col, v)
            store.SetBodyText(nb)
        }

        .TableRowAdd(k) -> {
            let nb = tableAddRowText(.store.body_text, k)
            store.SetBodyText(nb)
        }

        .TableRowRemove(k, ri) -> {
            let nb = tableRemoveRowText(.store.body_text, k, ri)
            store.SetBodyText(nb)
        }

        .Toggle(k, on) -> {
            var nv = "false"
            if on {
                nv = "true"
            }
            store.FieldEdited({ path: k, value: nv })
        }
    }
}
