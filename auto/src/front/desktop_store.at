// desktop_store.at — Plan 551 T4:Desktop 模块自定义视图数据面(插件机制
// 模块级覆盖旗舰)。os-config 侧栏第二项(System Overview 之后)。
//
// 数据单源:GET/PUT /api/config/desktop → ~/.config/autoos/apps/desktop/
// config.at(桌面宿主 boot 读 + 宿主侧轮询热应用,auto-lang Plan 551 T6)。
// 写 = editField 单字段全编辑(引号/转义由 api 层 quote_json 收口)+
// putConfigSafe 整体回传(daemon merge 折叠进现有 AST,未触碰字段不丢)。
//
// 预载约定:Modules.Select 命中 view == "desktop_page" 时调 Init
//(vm 子 widget 无 auto-Init,plan010 R10 同 Collection 先例;vue 端幂等)。
// 子页四枚:Dock / 通知 / 外观 / 关于——「系统」子页随 ⚙️ 直开 os-config
// 退役(auto-lang Plan 551 用户裁定:os-config 本体即设置中心)。
use back.api: fetchDesktopCfgSafe, putConfigSafe, editField, cfgField
// PLAN-012 F6：主题双写链——显示页深浅色按钮经 Theme.SetMode 进程内即时
// 生效（renderer 每帧读根状态 dark_mode/accent_color）+ config.at 双写
// （dark_theme/theme_source=manual，宿主 boot 真源；原 cfg_theme 为宿主
// 不读的幽灵字段——F6 根因）。
use theme_store: Theme

store DesktopCfg {
    model {
        var module_id str = "desktop"
        var loading bool = false
        var error str = ""
        // 二级导航:dock | notes | appearance | about。PLAN-012 F5：缺省
        // 落「显示」(appearance)——主题/accent 最高频。
        var section str = "appearance"
        // accent 选中镜像（真源在 Theme store/autoos-ui.json；Init 不回读，
        // 首次点击后即镜像——v1 取舍）。
        var accent str = "indigo"

        // ---- 单源快照(GET 投影,unquote 后显示值;缺席回退宿主内置默认)----
        var cfg_dock_position str = "bottom"   // bottom | top
        var cfg_dock_enabled str = "1"         // 1 | 0
        var cfg_dock_pinned str = ""
        var cfg_wallpaper str = ""
        var cfg_wallpapers_dir str = ""
        var cfg_theme str = "dark"             // dark | light
        var cfg_transparency str = "off"       // off | low | high
        var cfg_notes_enabled str = "1"        // 1 | 0

        // ---- 输入草稿(空 = 不写)----
        var pinned_draft str = ""
        var pinned_saved str = "0"
        var wallpapers_dir_draft str = ""

        // 编辑基底(GET 的 value 文本;editField 全编辑基准)
        var body str = "{}"
    }

    msg Msg { Init(str), Nav(str),
              PickPosition(str), PickEnabled(str), DraftPinned(str), SavePinned,
              PickNotes(str),
              DraftWallpapersDir(str), SaveWallpapersDir, RequestWallpaperPick,
              PickTheme(str), PickTransparency(str), PickAccent(str) }

    on {
        .Init(id) -> {
            .module_id = id
            .loading = true
            .error = ""
            let r = fetchDesktopCfgSafe(id)
            if r.ok {
                .body = r.body
                // PLAN-012 F6：读侧字段名勘正——daemon body 键 = 宿主
                // config.at 叶名（dock_position/dark_theme/...），原 cfg_*
                // 前缀键永不命中（幽灵字段——实机 config.at 里躺着的
                // cfg_theme/cfg_transparency 即本页旧写污染）。
                .cfg_dock_position = cfgField(.body, "dock_position")
                if .cfg_dock_position == "" {
                    .cfg_dock_position = "bottom"
                }
                .cfg_dock_enabled = cfgField(.body, "dock_enabled")
                if .cfg_dock_enabled == "true" {
                    .cfg_dock_enabled = "1"
                }
                if .cfg_dock_enabled == "" || .cfg_dock_enabled == "false" {
                    .cfg_dock_enabled = "0"
                }
                .cfg_dock_pinned = cfgField(.body, "dock_pinned")
                .cfg_wallpaper = cfgField(.body, "wallpaper_path")
                .cfg_wallpapers_dir = cfgField(.body, "wallpapers_dir")
                .cfg_theme = cfgField(.body, "dark_theme")
                if .cfg_theme == "true" {
                    .cfg_theme = "dark"
                }
                if .cfg_theme == "" || .cfg_theme == "false" {
                    .cfg_theme = "light"
                }
                .cfg_transparency = cfgField(.body, "transparency")
                if .cfg_transparency == "" {
                    .cfg_transparency = "off"
                }
                .cfg_notes_enabled = cfgField(.body, "notes_enabled")
                if .cfg_notes_enabled == "true" {
                    .cfg_notes_enabled = "1"
                }
                if .cfg_notes_enabled == "" || .cfg_notes_enabled == "false" {
                    .cfg_notes_enabled = "0"
                }
            } else {
                .error = r.error
            }
            .loading = false
        }

        .Nav(s) -> {
            .section = s
        }

        .PickPosition(v) -> {
            .cfg_dock_position = v
            .body = editField(.body, "dock_position", v)
            let r = putConfigSafe(.module_id, .body)
            if r.ok == false {
                .error = r.error
            }
        }

        .PickEnabled(v) -> {
            .cfg_dock_enabled = v
            // 宿主 bool 字段：view "1"/"0" → 写 "true"/"false"（editField
            // 旧 bool 类型保形；原 cfg_dock_enabled 幽灵键退役）。
            .body = editField(.body, "dock_enabled", if v == "1" { "true" } else { "false" })
            let r = putConfigSafe(.module_id, .body)
            if r.ok == false {
                .error = r.error
            }
        }

        .DraftPinned(v) -> {
            .pinned_draft = v
        }

        .SavePinned -> {
            if .pinned_draft != "" {
                .cfg_dock_pinned = .pinned_draft
                .body = editField(.body, "dock_pinned", .pinned_draft)
                let r = putConfigSafe(.module_id, .body)
                if r.ok == false {
                    .error = r.error
                }
                .pinned_saved = "1"
            }
        }

        .PickNotes(v) -> {
            .cfg_notes_enabled = v
            .body = editField(.body, "notes_enabled", if v == "1" { "true" } else { "false" })
            let r = putConfigSafe(.module_id, .body)
            if r.ok == false {
                .error = r.error
            }
        }

        // 016:「切换壁纸」按钮 = 请求桌面宿主 wallpaper_pick 组合(os-019
        // PLAN-019 机制:显示桌面(负一屏) + 壁纸 carousel,点选热应用,关闭
        // 自动回 origin)。跨进程通道 = config.at 的 wallpaper_request 字段:
        // 宿主 config 轮询差分臂只认值变化(不清值,config 单写方仍是
        // daemon/设置面)。故每次点击读文件现值并翻转("1"/"2" 互斥)——
        // 从现值翻转保证与宿主回写/设置面重启后都恒为变化。
        .RequestWallpaperPick -> {
            let prev = cfgField(.body, "wallpaper_request")
            var next = "2"
            if prev == "2" {
                next = "1"
            }
            .body = editField(.body, "wallpaper_request", next)
            let w = putConfigSafe(.module_id, .body)
            if w.ok == false {
                .error = w.error
            }
        }

        .DraftWallpapersDir(v) -> {
            .wallpapers_dir_draft = v
        }

        .SaveWallpapersDir -> {
            if .wallpapers_dir_draft != "" {
                .cfg_wallpapers_dir = .wallpapers_dir_draft
                .body = editField(.body, "wallpapers_dir", .wallpapers_dir_draft)
                let r = putConfigSafe(.module_id, .body)
                if r.ok == false {
                    .error = r.error
                }
            }
        }

        .PickTheme(v) -> {
            .cfg_theme = v
            // ① 进程内即时生效（renderer 每帧读根状态 dark_mode——
            // ThemePicker 同链；原 cfg_theme 幽灵键 = F6「切换无效」根因）。
            Theme.SetMode(v)
            // ② config.at boot 真源双写：dark_theme（bool 保形）+ 
            // theme_source=manual（否则宿主 load 按 system 从 OS 重派生
            // 覆盖——单写 dark_theme 会被回滚）。
            .body = editField(.body, "dark_theme", if v == "dark" { "true" } else { "false" })
            .body = editField(.body, "theme_source", "manual")
            let r = putConfigSafe(.module_id, .body)
            if r.ok == false {
                .error = r.error
            }
        }

        // PLAN-012 F5：accent 五圆点（ThemePicker 同链中转——desktop_page
        // 视图不做跨 store 绑定，镜像选中态存 .accent）。
        .PickAccent(name) -> {
            .accent = name
            Theme.SetAccent(name)
        }

        .PickTransparency(v) -> {
            .cfg_transparency = v
            .body = editField(.body, "transparency", v)
            let r = putConfigSafe(.module_id, .body)
            if r.ok == false {
                .error = r.error
            }
        }
    }
}
