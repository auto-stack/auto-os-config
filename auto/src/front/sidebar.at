// sidebar.at — unified module navigation (Plan 008 Phase 3 batch 1).
//
// ONE view source for BOTH backends: vue (regen → Sidebar.vue consumed by
// AppShell) and vm (auto run -r vm, child of the vm root App). Replaces the
// vue-only named-class sidebar (Plan 006) AND sidebar_vm.at (Plan 007).
//
// Style vocabulary per auto/README §共享样式词汇 (Plan 008 Phase 2):
//   - marker classes (sidebar/nav-item/nav-name/nav-desc/theme-picker/swatch)
//     are INERT test hooks — no CSS defines them on web, vm skips them;
//   - neutrals are deterministic hex classes; accent only via `primary`;
//   - no fractional spacing (vm drops py-1.5/gap-1.5);
//   - conditional classes use if-literal form (P1-proven both backends).
//
// Structure notes:
//   - search/filter/fold state lives in modules_store projections
//     (view_standalone/view_groups) — vm views cannot call .includes(), and
//     widget `computed` blocks with ext fns are vue-only;
//   - nav buttons carry two spans (name / description): vue renders them as
//     stacked elements, vm collapses children into a two-line label
//     (extract_children_text joins with \n) — D5 structural parity;
//   - the theme picker moved into its own ThemePicker widget (VG16: one
//     store per widget — Sidebar owns Modules only).
use modules_store: Modules
use theme_picker: ThemePicker

widget Sidebar {
    msg Msg { SearchChanged(str), SelectModule(str), ToggleGroup(str) }

    view {
        aside (style: "sidebar flex flex-col w-[280px] shrink-0 bg-[#f9f9f9] border-r border-[#e0e0e0]") {
            div (style: "flex items-center gap-2 px-5 py-4 text-base font-semibold text-[#1a1a1a]") {
                span (text: "⚙️", style: "text-xl") {}
                text (text: "AutoOS Settings") {}
            }
            div (style: "pt-2 px-4 pb-3") {
                input (style: "search-input w-full px-3 py-2 text-sm bg-[#f0f0f0] border border-[#e0e0e0] rounded", value: .store.search, oninput: .SearchChanged, placeholder: "Search settings") {}
            }
            nav (style: "nav-list flex-1 overflow-auto px-2") {
                if .store.search == "" {
                    for m in .store.view_standalone {
                        // R4（plan010 T8）:vm button 对 `class: <loop 字段表达式>`
                        // 求值失败 → convert_button 兜底 primary preset（紫块/白字/
                        // h-10 裁掉 3 行折叠 label 的 2、3 行）。条件展开双态静态串
                        // 是 vm 可解析的等价形态（theme_picker swatch 同款词汇）。
                        // 串尾 text-[#1a1a1a]/h-auto、idle 态 bg-[#f9f9f9] 为 vm
                        // 中和类——vue 端 CSS 效果等价（侧栏纯色底/子元素自带文字色）。
                        if .store.active_id == m.id {
                            button (class: "nav-item active w-full text-left flex items-start gap-3 px-3 py-[10px] rounded bg-primary/10 text-[#1a1a1a] h-auto", key: m.id) {
                                onclick: .SelectModule(m.id)
                                row (style: "flex flex-row gap-3 w-full") {
                                span (text: m.icon, style: "nav-icon text-lg shrink-0 pt-px") {}
                                col (style: "nav-text flex-1 min-w-0 flex flex-col gap-[0px]") {
                                    text (text: m.name, class: m.name_class) {}
                                    text (text: m.description, style: "nav-desc text-xs text-[#8a8a8a] truncate") {}
                                }
                                }
                            }
                        }
                        if .store.active_id != m.id {
                            button (class: "nav-item w-full text-left flex items-start gap-3 px-3 py-[10px] rounded bg-[#f9f9f9] hover:bg-[#ededed] transition-colors duration-[120ms] text-[#1a1a1a] h-auto", key: m.id) {
                                onclick: .SelectModule(m.id)
                                row (style: "flex flex-row gap-3 w-full") {
                                span (text: m.icon, style: "nav-icon text-lg shrink-0 pt-px") {}
                                col (style: "nav-text flex-1 min-w-0 flex flex-col gap-[0px]") {
                                    text (text: m.name, class: m.name_class) {}
                                    text (text: m.description, style: "nav-desc text-xs text-[#8a8a8a] truncate") {}
                                }
                                }
                            }
                        }
                    }
                }

                for g in .store.view_groups {
                        if .store.search == "" {
                            button (style: "group-header w-full text-left flex items-center gap-[6px] px-3 py-[10px] mt-2 rounded bg-[#f9f9f9] hover:bg-[#ededed] transition-colors duration-[120ms] text-[#1a1a1a] h-auto") {
                                key: g.id
                                onclick: .ToggleGroup(g.id)
                                // T14b: vm button 子树按结构竖排渲染（上游 05b9362af
                                // 行为），▾/label 需显式 row 才左右排列、高度正常
                                row (style: "flex flex-row items-center gap-[6px] w-full gap-[0px]") {
                                    if g.open {
                                        text (text: "▾", style: "text-[11px] text-[#8a8a8a] w-[14px] shrink-0") {}
                                    }
                                    if g.open == false {
                                        text (text: "▸", style: "text-[11px] text-[#8a8a8a] w-[14px] shrink-0") {}
                                    }
                                    text (text: g.label, style: "text-sm font-semibold text-[#1a1a1a]") {}
                                }
                            }
                        }
                        if .store.search != "" {
                            for m in g.members {
                                if .store.active_id == m.id {
                                    button (class: "nav-item active w-full text-left flex items-start gap-3 pl-[28px] pr-3 py-[10px] rounded bg-primary/10 text-[#1a1a1a]", key: m.id) {
                                        onclick: .SelectModule(m.id)
                                        row (style: "flex flex-row gap-3 w-full") {
                                        span (text: m.icon, style: "nav-icon text-lg shrink-0 pt-px") {}
                                        col (style: "nav-text flex-1 min-w-0 flex flex-col gap-[0px]") {
                                            text (text: m.name, class: m.name_class) {}
                                            text (text: m.description, style: "nav-desc text-xs text-[#8a8a8a] truncate") {}
                                        }
                                        }
                                    }
                                }
                                if .store.active_id != m.id {
                                    button (class: "nav-item w-full text-left flex items-start gap-3 pl-[28px] pr-3 py-[10px] rounded bg-[#f9f9f9] hover:bg-[#ededed] transition-colors duration-[120ms] text-[#1a1a1a]", key: m.id) {
                                        onclick: .SelectModule(m.id)
                                        row (style: "flex flex-row gap-3 w-full") {
                                        span (text: m.icon, style: "nav-icon text-lg shrink-0 pt-px") {}
                                        col (style: "nav-text flex-1 min-w-0 flex flex-col gap-[0px]") {
                                            text (text: m.name, class: m.name_class) {}
                                            text (text: m.description, style: "nav-desc text-xs text-[#8a8a8a] truncate") {}
                                        }
                                        }
                                    }
                                }
                            }
                        }
                        if .store.search == "" {
                            if g.open {
                                for m in g.members {
                                    if .store.active_id == m.id {
                                        button (class: "nav-item active w-full text-left flex items-start gap-3 pl-[28px] pr-3 py-[10px] rounded bg-primary/10 text-[#1a1a1a]", key: m.id) {
                                            onclick: .SelectModule(m.id)
                                            row (style: "flex flex-row gap-3 w-full") {
                                            span (text: m.icon, style: "nav-icon text-lg shrink-0 pt-px") {}
                                            col (style: "nav-text flex-1 min-w-0 flex flex-col gap-[0px]") {
                                                text (text: m.name, class: m.name_class) {}
                                                text (text: m.description, style: "nav-desc text-xs text-[#8a8a8a] truncate") {}
                                            }
                                            }
                                        }
                                    }
                                    if .store.active_id != m.id {
                                        button (class: "nav-item w-full text-left flex items-start gap-3 pl-[28px] pr-3 py-[10px] rounded bg-[#f9f9f9] hover:bg-[#ededed] transition-colors duration-[120ms] text-[#1a1a1a]", key: m.id) {
                                            onclick: .SelectModule(m.id)
                                            row (style: "flex flex-row gap-3 w-full") {
                                            span (text: m.icon, style: "nav-icon text-lg shrink-0 pt-px") {}
                                            col (style: "nav-text flex-1 min-w-0 flex flex-col gap-[0px]") {
                                                text (text: m.name, class: m.name_class) {}
                                                text (text: m.description, style: "nav-desc text-xs text-[#8a8a8a] truncate") {}
                                            }
                                            }
                                        }
                                    }
                                }
                            }
                    }
                }

                if .store.loading {
                    text (text: "Loading modules...", style: "block p-4 text-center text-xs text-[#8a8a8a]") {}
                }
                if .store.loading == false {
                    if .store.search != "" {
                        if .store.has_results == false {
                            text (text: "No modules found.", style: "block p-4 text-center text-xs text-[#8a8a8a]") {}
                        }
                    }
                }
            }
            ThemePicker { }
        }
    }

    on {
        .SearchChanged(q) -> { store.Search(q) }
        .SelectModule(mid) -> { store.Select(mid) }
        .ToggleGroup(gid) -> { store.ToggleGroup(gid) }
    }
}
