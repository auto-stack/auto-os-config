// sidebar.at — unified module navigation.
//
// ONE view source for BOTH backends (vue regen + vm), built on the auto-lang
// Plan 482 nav component family:
//   - nav(search:) integrates the search row (contract classes, onsearch msg);
//   - nav-item carries hover/active(disabled) states + icon/label/desc slots
//     from the shared class contract — no store-precomputed class strings;
//     active is a live view expression (fa41ef5 stale-highlight root-cause
//     eliminated); data-active anchor for tests/a11y;
//   - nav-group renders collapsible group headers (open bound to the store
//     projection, ontoggle -> ToggleGroup);
//   - marker classes (sidebar/nav-list/theme-picker) remain inert test hooks;
//     neutrals stay deterministic hex; no fractional spacing (vm drops them).
//
use modules_store: Modules
use theme_picker: ThemePicker

widget Sidebar {
    msg Msg { SearchChanged(str), SelectModule(str), ToggleGroup(str), SelectOverview }

    view {
        aside (style: "sidebar flex flex-col w-[280px] shrink-0 bg-[#f9f9f9] border-r border-[#e0e0e0]") {
            div (style: "flex items-center gap-2 px-5 py-4 text-base font-semibold text-[#1a1a1a] h-[50px]") {
                span (text: "⚙️", style: "text-xl") {}
                text (text: "AutoOS Settings") {}
            }
            // Plan 012(上游 auto-lang 482):nav(search:) 集成搜索行——
            // 契约类(边框/muted 底/放大镜)取代手搓 input;placeholder/onsearch
            // 语义不变。pt-2 pb-3 维持原纵向节律(搜索行自带 mx-3 mb-2)。
            nav (search: true, search_value: .store.search, onsearch: .SearchChanged,
                 search_placeholder: "Search settings",
                 style: "nav-list flex-1 overflow-auto px-2 pt-2 flex flex-col") {
                // Plan 011 T12:首页入口置顶(选中态 = active_kind == "")——
                // Plan 012:双 if 块合一,active 由 nav-item 契约承载
                // (hover/选中主色调内建,h-[50px] 用户类追加保行高)。
                nav-item (onclick: .SelectOverview, active: .store.active_kind == "",
                          icon: "🏠", label: "System Overview",
                          desc: "System information dashboard",
                          size: "lg", style: "h-[50px] mb-1", key: "ov-home")
                if .store.search == "" {
                    for m in .store.view_standalone {
                        nav-item (onclick: .SelectModule(m.id), active: .store.active_id == m.id,
                                  icon: m.icon, label: m.name, desc: m.description,
                                  size: "lg", key: m.id)
                    }
                }

                for g in .store.view_groups {
                    if .store.search == "" {
                        // Plan 012:组头 nav-group 契约承载(chevron+折叠);
                        // open 绑定投影,ontoggle 走既有 ToggleGroup 消息。
                        nav-group (label: g.label, collapsible: true, open: g.open,
                                   ontoggle: .ToggleGroup(g.id)) {
                            for m in g.members {
                                nav-item (onclick: .SelectModule(m.id), active: .store.active_id == m.id,
                                          icon: m.icon, label: m.name, desc: m.description,
                                          size: "lg", key: m.id)
                            }
                        }
                    }
                    if .store.search != "" {
                        // 搜索期扁平:组头隐藏,命中成员直出(投影语义不变)。
                        for m in g.members {
                            nav-item (onclick: .SelectModule(m.id), active: .store.active_id == m.id,
                                      icon: m.icon, label: m.name, desc: m.description,
                                      size: "lg", key: m.id)
                        }
                    }
                }

                if .store.loading {
                    text (text: "Loading modules...", style: "block p-4 text-center text-xs text-[#8a8a8a]") {}
                }
                if .store.loading == false {
                    if .store.search != "" {
                        if .store.has_results == false {
                            text (text: "No modules found.", style: "block p-4 text-center text-xs text-[#8a8a8a]") {}
                        }
                    }
                }
            }
            ThemePicker { }
        }
    }

    on {
        .SearchChanged(q) -> { store.Search(q) }
        .SelectModule(mid) -> { Modules.Select(mid) }
        .ToggleGroup(gid) -> { store.ToggleGroup(gid) }
        .SelectOverview -> { store.Overview() }
    }
}
