// sidebar_vm.at — vm sidebar: group nav + standalone modules (Plan 007).
// VG16: Modules store only. v1 deviation (registered): no group collapse —
// all groups render open (vm view has no array.includes and the child widget
// cannot observe store Init to seed a mirror).
use modules_store: Modules

widget SidebarVm {
    view {
        col (style: "gap-1") {
            for g in .store.groups {
                col (style: "gap-0.5") {
                    text (text: "▾ " + g.label, style: "px-2 py-1 font-medium text-sm") {}
                    for m in g.members {
                        button (text: m.icon + "  " + m.name, style: "w-full text-left px-4 py-1 rounded") {
                            onclick: .Pick(m.id)
                        }
                    }
                }
            }
            for m in .store.standalone {
                button (text: m.icon + "  " + m.name, style: "w-full text-left px-2 py-1 rounded") {
                    onclick: .Pick(m.id)
                }
            }
        }
    }

    on {
        .Pick(id) -> {
            store.Select(id)
        }
    }
}
