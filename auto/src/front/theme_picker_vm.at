// theme_picker_vm.at — vm theme picker (Plan 007). The vm renderer reads
// `accent_color`-shaped state from the root widget each frame and resolves
// semantic tokens (text-primary etc.) against the 5-color AutoForge palette —
// the same palette the web track uses (api.ts ACCENT_OPTIONS).
use theme_store: Theme

widget ThemePickerVm {
    view {
        row (style: "gap-2 px-2") {
            text (text: "Accent", style: "text-xs") {}
            button (text: "Indigo", style: "px-2 py-0.5 rounded border text-xs") { onclick: .Pick("indigo") }
            button (text: "Coral", style: "px-2 py-0.5 rounded border text-xs") { onclick: .Pick("coral") }
            button (text: "Ocean", style: "px-2 py-0.5 rounded border text-xs") { onclick: .Pick("ocean") }
            button (text: "Sage", style: "px-2 py-0.5 rounded border text-xs") { onclick: .Pick("sage") }
            button (text: "Amber", style: "px-2 py-0.5 rounded border text-xs") { onclick: .Pick("amber") }
        }
    }

    on {
        .Pick(name) -> {
            store.SetAccent(name)
        }
    }
}
