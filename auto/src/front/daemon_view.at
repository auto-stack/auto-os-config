// daemon_view.at — unified Daemon test-connection card (Plan 008 Phase 3
// batch 2; 2026-08-27 视图层回归 CSS 原版形态——像素对拍基准).
//
// ONE view source for BOTH backends (vue regen + vm interpret). The embedded
// ConfigEditor child lives at the roots (app.at renders DaemonView + editor
// as siblings); the card's 16px bottom margin (css-era .test-card
// margin-bottom) separates them.
//
// 2026-08-27 对拍：DOM 与命名类回归 css-era DaemonView（test-card/test-row/
// test-label/test-status/btn/test-err/test-hint/inline-code），样式由
// styles.css「.daemon-view 复刻块」按 scoped 原值实现；状态色走 tailwind
// 确定性类（--success/--danger/--text-muted 同值）；offline 提示的内联代码
// 片用 span.inline-code 还原。按钮仍用 flex-1 spacer 右推（vm 无 ml-auto）。
use back.api: testDaemon

widget DaemonView(module_id: str) {
    msg Msg { Test }

    model {
        var status str = "idle"
        var test_error str = ""
        var latency int = 0
    }

    view {
        col (style: "daemon-view test-card gap-[0px] max-w-[820px]") {
            row (style: "test-row gap-[14px]") {
                span (text: "Daemon connection", style: "test-label") {}
                span (style: "test-status") {
                    if .status == "idle" {
                        text (text: "not tested", style: "text-[#8a8a8a]") {}
                    }
                    if .status == "checking" {
                        text (text: "testing…", style: "text-[#8a8a8a]") {}
                    }
                    if .status == "ok" {
                        text (text: "✓ online (" + .latency + "ms)", style: "font-medium text-[#107c10]") {}
                    }
                    if .status == "unreachable" {
                        text (text: "offline", style: "italic text-[#8a8a8a]") {}
                    }
                    if .status == "fail" {
                        text (text: "✗ failed", style: "font-medium text-[#c42b1c]") {}
                    }
                }
                div (style: "flex-1") {}
                button (text: "Test", style: "btn bg-white border border-[#e0e0e0] rounded px-5 py-2 text-sm text-[#1a1a1a] h-auto", disabled: .status == "checking") {
                    onclick: .Test
                }
            }
            if .status == "fail" && .test_error != "" {
                p (style: "test-err", text: .test_error) {}
            }
            if .status == "unreachable" {
                p (style: "test-hint") {
                    text (text: "The AI Daemon (aaid, :17654) is offline. Start it with ") {}
                    span (style: "inline-code", text: "cargo run -p auto-ai-daemon") {}
                    text (text: ". Config fields below can still be edited — they're written to ") {}
                    span (style: "inline-code", text: "ai-daemon.at") {}
                    text (text: " directly.") {}
                }
            }
        }
    }

    on {
        .Test -> {
            .status = "checking"
            .test_error = ""
            var r = testDaemon()
            .status = r.status
            .test_error = r.error
            .latency = r.latency
        }
    }
}
