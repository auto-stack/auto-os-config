// theme_picker.at — 左下角 Settings 齿轮 + popover 弹窗（概要页四期，
// 2026-08-29）。对标 auto-musk settings_menu.at（trigger 开合 + 分段
// panel）：Theme 两档（Light/Dark）+ Accent 五圆点迁入弹窗；原底部平铺
// "Accent color" 区退役。Language/Forge/AutoOS 段不搬（本仓无对应后端）。
//
// 单源双端（vue regen → ThemePicker.vue；vm child widget of Sidebar）。
// vm 轨 popover 自带点外关/Esc/点 trigger 关（PopoverWidget）；vue 非
// shadcn popover 为惰性 div 透传（:open 无效）——部署侧 regen.sh sed
// 补偿 :open→v-if（collection_browser C1 确认层先例），点外关 vue 端登记
// 差异（再点 trigger 关闭，auto-musk 同款舍弃）。
//
// 样式纪律：面板/选项全部语义色（bg-card/border-border/text-foreground/
// text-muted-foreground/text-primary）——弹窗必须随深浅色主题翻转。swatch
// 五色是品牌常量 hex 保留；选中环从 shadow hex 双色（深色下错色）改
// border-foreground 语义。marker class `swatch` 是惰性测试钩子
// （.theme-picker .swatch 仍被 test-theme-switch 断言）。
use theme_store: Theme

widget ThemePicker {
    msg Msg { Toggle, Close, SetTheme(str), SetAccent(str) }

    model {
        var open bool = false
    }

    view {
        col (style: "theme-picker shrink-0 pt-3 pb-4 px-5 border-t border-border gap-[0px]") {
            popover (open: .open, ondismiss: .Close, placement: "top-start", class: "w-[240px] bg-card border border-border rounded-lg shadow-lg") {
                popover_trigger {
                    button (style: "settings-trigger w-full h-9 flex flex-row items-center gap-2 px-2 rounded-md hover:bg-secondary") {
                        span (text: "⚙️", style: "text-base leading-none") {}
                        text (text: "Settings", style: "text-sm font-medium text-foreground") {}
                    }
                }
                popover_content {
                    col (style: "settings-panel flex flex-col gap-[0px] p-2") {
                        text (text: "Theme", style: "settings-section-title text-xs font-semibold text-muted-foreground uppercase tracking-wider px-2 pb-2") {}
                        button (style: if .store.mode == "light" { "theme-option flex flex-row items-center gap-2 w-full px-2 py-[6px] rounded-md text-sm text-foreground bg-primary/10" } else { "theme-option flex flex-row items-center gap-2 w-full px-2 py-[6px] rounded-md text-sm text-foreground hover:bg-secondary" }) {
                            onclick: .SetTheme("light")
                            span (text: "🌞", style: "text-sm leading-none") {}
                            text (text: "Light", style: "flex-1 text-left") {}
                            if .store.mode == "light" {
                                text (text: "✓", style: "text-xs font-bold text-primary") {}
                            }
                        }
                        button (style: if .store.mode == "dark" { "theme-option flex flex-row items-center gap-2 w-full px-2 py-[6px] rounded-md text-sm text-foreground bg-primary/10" } else { "theme-option flex flex-row items-center gap-2 w-full px-2 py-[6px] rounded-md text-sm text-foreground hover:bg-secondary" }) {
                            onclick: .SetTheme("dark")
                            span (text: "🌙", style: "text-sm leading-none") {}
                            text (text: "Dark", style: "flex-1 text-left") {}
                            if .store.mode == "dark" {
                                text (text: "✓", style: "text-xs font-bold text-primary") {}
                            }
                        }
                        text (text: "Accent color", style: "settings-section-title text-xs font-semibold text-muted-foreground uppercase tracking-wider px-2 pt-3 pb-2") {}
                        row (style: "swatches flex flex-row items-center gap-[10px] px-2 pb-1") {
                            button (style: if .store.current == "indigo" { "swatch w-6 h-6 rounded-full border-2 border-foreground flex flex-row items-center justify-center bg-[#6366f1] cursor-pointer" } else { "swatch w-6 h-6 rounded-full border-2 border-transparent flex flex-row items-center justify-center bg-[#6366f1] cursor-pointer" }) {
                                onclick: .SetAccent("indigo")
                                if .store.current == "indigo" {
                                    text (text: "✓", style: "text-xs font-bold text-white leading-none") {}
                                }
                            }
                            button (style: if .store.current == "coral" { "swatch w-6 h-6 rounded-full border-2 border-foreground flex flex-row items-center justify-center bg-[#e85d75] cursor-pointer" } else { "swatch w-6 h-6 rounded-full border-2 border-transparent flex flex-row items-center justify-center bg-[#e85d75] cursor-pointer" }) {
                                onclick: .SetAccent("coral")
                                if .store.current == "coral" {
                                    text (text: "✓", style: "text-xs font-bold text-white leading-none") {}
                                }
                            }
                            button (style: if .store.current == "ocean" { "swatch w-6 h-6 rounded-full border-2 border-foreground flex flex-row items-center justify-center bg-[#3b82f6] cursor-pointer" } else { "swatch w-6 h-6 rounded-full border-2 border-transparent flex flex-row items-center justify-center bg-[#3b82f6] cursor-pointer" }) {
                                onclick: .SetAccent("ocean")
                                if .store.current == "ocean" {
                                    text (text: "✓", style: "text-xs font-bold text-white leading-none") {}
                                }
                            }
                            button (style: if .store.current == "sage" { "swatch w-6 h-6 rounded-full border-2 border-foreground flex flex-row items-center justify-center bg-[#10b981] cursor-pointer" } else { "swatch w-6 h-6 rounded-full border-2 border-transparent flex flex-row items-center justify-center bg-[#10b981] cursor-pointer" }) {
                                onclick: .SetAccent("sage")
                                if .store.current == "sage" {
                                    text (text: "✓", style: "text-xs font-bold text-white leading-none") {}
                                }
                            }
                            button (style: if .store.current == "amber" { "swatch w-6 h-6 rounded-full border-2 border-foreground flex flex-row items-center justify-center bg-[#f59e0b] cursor-pointer" } else { "swatch w-6 h-6 rounded-full border-2 border-transparent flex flex-row items-center justify-center bg-[#f59e0b] cursor-pointer" }) {
                                onclick: .SetAccent("amber")
                                if .store.current == "amber" {
                                    text (text: "✓", style: "text-xs font-bold text-white leading-none") {}
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .Toggle -> { .open = !.open }
        .Close -> { .open = false }
        .SetTheme(m) -> { store.SetMode(m) }
        .SetAccent(name) -> { store.SetAccent(name) }
    }
}
