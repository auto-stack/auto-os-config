// vm_editor.at — ConfigEditorVm: stateless per-module file editor (Plan 007
// Phase 4). All logic via the flat back.api surface; edits are draft + Apply
// per row (single-param input handlers keep autoui_type drivable; VG rules).
//
// v1 deviations (registered): select renders as text input + option hint (no
// dropdown on vm); multiselect/tags use text add + chip remove; block
// add/delete not exposed (web-only until Phase 5+).
use back.api: fetchConfigSafe, putConfigSafe, entriesCount, entryAt, editField, editTagField

widget ConfigEditorVm(module_id: str) {
    model {
        var body str = ""
        var entries []any = []
        var loading bool = false
        var error str = ""
        var dirty bool = false
        var saving bool = false
        var loaded_once bool = false
        var draft str = ""
        var pw_show bool = false
        var status str = ""
    }

    view {
        col (style: "h-full") {
            row (style: "gap-3 items-center p-3 border-b") {
                text (text: "Editor", style: "font-bold") {}
                button (text: "Load") { onclick: .Load }
                if .dirty {
                    text (text: "● unsaved", style: "text-xs text-amber-500") {}
                }
                if .dirty == false {
                    text (text: "saved", style: "text-xs text-gray-400") {}
                }
                button (text: "Save", style: "px-3 py-1 rounded border text-primary") {
                    onclick: .Save
                }
                text (text: .status, style: "text-xs") {}
            }
            scroll (style: "flex-1 p-4") {
                col (style: "gap-3") {
                    if .loading {
                        text (text: "Loading...") {}
                    }
                    if .error != "" {
                        text (text: "⚠️ " + .error, style: "text-red-500") {}
                    }
                    for e in .entries {
                        if e.is_table {
                            // v1: nested tables render as the raw JSON text
                            // (read-only) — the table editor lands with the
                            // collection browser refinement.
                            col (style: "border rounded p-2 gap-1") {
                                text (text: e.label, style: "font-medium") {}
                                text (text: e.frag, style: "text-xs text-gray-500") {}
                            }
                        }
                        if e.is_table == false && e.kind == "subform" {
                            col (style: "border rounded p-2 gap-1") {
                                text (text: e.label, style: "font-medium") {}
                                text (text: e.frag, style: "text-xs text-gray-500") {}
                            }
                        }
                        if e.kind == "toggle" {
                            row (style: "gap-2 items-center") {
                                checkbox (id: e.key, checked: e.value, label: e.label) {
                                    onclick: .Toggle(e)
                                }
                            }
                        }
                        if e.kind == "number" {
                            col (style: "gap-1") {
                                text (text: e.label, style: "text-sm") {}
                                row (style: "gap-2") {
                                    input (placeholder: e.label, "type": "number", value: e.value) {
                                        oninput: .Draft
                                    }
                                    button (text: "Apply") { onclick: .Apply(e) }
                                }
                            }
                        }
                        if e.kind == "password" {
                            col (style: "gap-1") {
                                text (text: e.label, style: "text-sm") {}
                                row (style: "gap-2") {
                                    if .pw_show {
                                        input (placeholder: e.label, value: e.value) {
                                            oninput: .Draft
                                        }
                                    }
                                    if .pw_show == false {
                                        input (placeholder: e.label, "type": "password", value: e.value) {
                                            oninput: .Draft
                                        }
                                    }
                                    button (text: "👁") { onclick: .PwToggle }
                                    button (text: "Apply") { onclick: .Apply(e) }
                                }
                            }
                        }
                        if e.kind == "text" || e.kind == "select" {
                            col (style: "gap-1") {
                                text (text: e.label, style: "text-sm") {}
                                row (style: "gap-2") {
                                    input (placeholder: e.label, value: e.value) {
                                        oninput: .Draft
                                    }
                                    button (text: "Apply") { onclick: .Apply(e) }
                                }
                                if e.url != "" {
                                    text (text: "(select field — free text accepted)", style: "text-xs text-gray-400") {}
                                }
                            }
                        }
                        if e.kind == "tags" || e.kind == "multiselect" {
                            col (style: "gap-1") {
                                text (text: e.label, style: "text-sm") {}
                                text (text: e.value, style: "text-xs text-gray-500") {}
                                row (style: "gap-2") {
                                    input (placeholder: "add value") {
                                        oninput: .Draft
                                    }
                                    button (text: "Add") { onclick: .TagAdd(e) }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .Load -> {
            .loading = true
            .error = ""
            var r = fetchConfigSafe(.module_id)
            if r.ok {
                .body = r.value
                var es = []
                let n = entriesCount(r.value)
                var i = 0
                loop {
                    if i >= n {
                        break
                    }
                    es.push(entryAt(r.value, i, .module_id))
                    i = i + 1
                }
                .entries = es
                .loaded_once = true
            }
            if r.ok == false {
                .error = "Failed to load config"
            }
            .loading = false
        }
        .Save -> {
            if .dirty && .body != "" {
                .saving = true
                .status = "saving..."
                var r = putConfigSafe(.module_id, .body)
                if r.ok {
                    .dirty = false
                    .status = "saved ✓"
                }
                if r.ok == false {
                    .status = "save failed"
                    .error = r.error
                }
                .saving = false
            }
        }
        .Draft(v str) -> {
            .draft = v
        }
        .PwToggle -> {
            .pw_show = .pw_show == false
        }
        .Toggle(e) -> {
            var nv = "false"
            if e.value == "false" || e.value == "" {
                nv = "true"
            }
            .body = editField(.body, e.key, nv)
            .dirty = true
            .Rebuild
        }
        .Apply(e) -> {
            if .draft != "" {
                .body = editField(.body, e.key, .draft)
                .dirty = true
                .Rebuild
            }
        }
        .TagAdd(e) -> {
            if .draft != "" {
                .body = editTagField(.body, e.key, .draft, "")
                .dirty = true
                .Rebuild
            }
        }
        .Rebuild -> {
            var es = []
            let n = entriesCount(.body)
            var i = 0
            loop {
                if i >= n {
                    break
                }
                es.push(entryAt(.body, i, .module_id))
                i = i + 1
            }
            .entries = es
            .draft = ""
        }
    }
}
