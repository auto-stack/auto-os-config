// config_editor.at — the unified generic config editor (Plan 008 Phase 3
// batch 3; 2026-08-27 视图层回归 CSS 原版形态——像素对拍基准).
//
// Architecture: the vm TEXT pipeline is the canonical contract
// (fetch/editField/editTagField over the body as a JSON string — api.ts
// mirrors every fn). The entry list is FLAT: subform fields are interleaved
// right after their subform row (subAt, dotted keys, depth=1) — no nested
// arrays in model maps (VG flat-return discipline), handler reads stay
// chain-direct off fn calls (VG4), and there are NO handler-to-handler msg
// calls (rebuild/save flows are inlined per site).
//
// 2026-08-27 视图对拍（css-era ConfigEditor/ScalarFields 1:1）：
//   - DOM 结构与命名类回归 css-era（toolbar/meta/actions/btn/field-row/
//     field-label/subform-*/input/toggle/secret…）；这些类由 styles.css 的
//     「.config-editor 复刻块」实现（css-era scoped CSS 原值拷贝，含伪类——
//     Tailwind 类串表达不了 input:checked + .toggle-track 这类选择器）；
//     vm 端命名类本就是惰性钩子；
//   - Init 消息回归：vue codegen → onMounted 自动加载（css-era 行为），
//     无 Load 按钮；vm 子组件无 auto-Init → Load 按钮只在 vm 出现；
//   - 编辑提交：输入 oninput 存 draft，onchange（失焦/回车）提交——视觉上
//     无 css-era 所无的 Apply 按钮（css-era 是逐键 live-apply，登记偏差）；
//   - Save 按钮 disabled: !dirty || saving（css-era 半透明禁用态还原）；
//   - subform 盒由平铺行拼装：header 行全边框，子行 subform-cont 补左右
//     边、末行补底边+下圆角（first/last 标记由 api.at subAt 预计算）；
//   - 已登记的降级残留（待后续批次还原）：select 暂为自由文本（枚举选项
//     管线未建）、tags/multiselect 暂为加号式（chips 未还原）、table 暂为
//     只读 JSON（可编辑表格未还原）、confirm 行内化（vm 无 window.confirm）。
use back.api: fetchConfigSafe, putConfigSafe, deleteBlockSafe, entriesCount, entryAt, entryAtW, subCount, subAt, editField, editTagField, addBlockText, bodyHasText, metaFile, warmEnumsText, setCellText, tableAddRowText, tableRemoveRowText, cfgField
use widgets: WallpaperPicker

widget ConfigEditor(module_id: str, widgets: str) {
    msg Msg {
        Init,
        Load,
        Save,
        ConfirmSaveYes,
        ConfirmSaveNo,
        Draft(str),
        NameDraft(str),
        Apply(map, str),
        TagAdd(map),
        TagRemove(map, str),
        Toggle(map, str),
        TableCell(map, int, str, str),
        TableRowAdd(map),
        TableRowRemove(map, int),
        PwToggle,
        ToggleAddBlock,
        AddBlock,
        CancelAddBlock,
        AskDelete(str),
        ConfirmDeleteYes,
        ConfirmDeleteNo
    }
    model {
        var wallpapers_dir str = ""
        var body str = ""
        var entries Array<str> = []
        var loading bool = false
        var error str = ""
        var dirty bool = false
        var saving bool = false
        var status str = ""
        var loaded_once bool = false
        var draft str = ""
        var pw_show bool = false
        var meta_file str = ""
        var adding_block bool = false
        var new_block_name str = ""
        var block_error str = ""
        var confirm_save bool = false
        var save_acked bool = false
        var confirm_del str = ""
    }

    view {
        div (style: "config-editor flex-1 flex flex-col max-w-[820px] gap-[16px]") {
            if .loading {
                div (style: "state-msg") {
                    text (text: "Loading…") {}
                }
            }
            if .loading == false && .error != "" && .body == "" {
                div (style: "state-msg error") {
                    text (text: "✗ " + .error) {}
                    span (style: "hint") {
                        text (text: "Is the config daemon running on :17701?") {}
                    }
                }
            }
            // 016 重设计:工具栏单行化——文件标识+状态在左,动作在右(此前
            // toolbar/meta/actions 只有 vue 命名类 CSS,vm 轨无布局样式导致
            // 按钮竖排堆叠);按钮全部补显式 utilities + border-0(vm 默认
            // 按钮边框抢镜)。
            row (style: "toolbar flex flex-row items-center gap-[8px]") {
                div (style: "meta flex flex-row items-center gap-[8px] flex-1 min-w-0") {
                    span (style: "mono text-xs text-muted-foreground bg-muted rounded-md px-2 py-1", text: .meta_file) {}
                    if .dirty {
                        span (style: "dirty text-xs text-warning", text: "● unsaved") {}
                    }
                }
                div (style: "actions flex flex-row items-center gap-[8px]") {
                    if .block_error != "" {
                        span (style: "block-error text-xs text-destructive", text: .block_error) {}
                    }
                    if .adding_block {
                        input (style: "block-name w-[180px] h-7 text-xs text-foreground bg-background border border-border rounded-md px-2", placeholder: "block name", value: .new_block_name) {
                            oninput: .NameDraft
                            onkeydown.enter: .AddBlock
                        }
                        button (style: "h-7 px-3 text-xs rounded-md bg-primary text-primary-foreground border-0", text: "Add") {
                            onclick: .AddBlock
                        }
                        button (style: "h-7 px-3 text-xs rounded-md bg-muted text-muted-foreground border-0", text: "Cancel") {
                            onclick: .CancelAddBlock
                        }
                    }
                    if .adding_block == false {
                        if .loaded_once {
                            button (style: "h-7 px-3 text-xs rounded-md bg-muted text-muted-foreground border-0", text: "＋ Add block") {
                                onclick: .ToggleAddBlock
                            }
                        }
                    }
                    if .loaded_once {
                        button (style: "h-7 px-3 text-xs rounded-md bg-muted text-muted-foreground border-0", text: "Reload", disabled: .saving) {
                            onclick: .Load
                        }
                    }
                    button (style: "h-8 px-4 text-xs font-medium rounded-md bg-primary text-primary-foreground border-0", disabled: .saving || .dirty == false) {
                        onclick: .Save
                        if .saving {
                            text (text: "Saving…") {}
                        }
                        if .saving == false {
                            text (text: "Save") {}
                        }
                    }
                }
            }
            if .confirm_save {
                row (style: "flex items-center gap-3 px-3 py-2 border border-border rounded bg-secondary") {
                    text (text: "Save changes to disk? (.bak backup kept)", style: "text-sm text-foreground") {}
                    div (style: "flex-1") {}
                    button (text: "Yes, save", style: "btn px-3 py-1 text-xs rounded bg-primary border-primary text-white") {
                        onclick: .ConfirmSaveYes
                    }
                    button (text: "Cancel", style: "btn px-3 py-1 text-xs rounded border border-border bg-background") {
                        onclick: .ConfirmSaveNo
                    }
                }
            }
            if .confirm_del != "" {
                row (style: "flex items-center gap-3 px-3 py-2 border border-[#c42b1c] rounded bg-secondary") {
                    text (text: "Delete block " + .confirm_del + "? (.bak kept)", style: "text-sm text-[#c42b1c]") {}
                    div (style: "flex-1") {}
                    button (text: "Yes, delete", style: "btn px-3 py-1 text-xs rounded bg-[#c42b1c] border-[#c42b1c] text-white") {
                        onclick: .ConfirmDeleteYes
                    }
                    button (text: "Cancel", style: "btn px-3 py-1 text-xs rounded border border-border bg-background") {
                        onclick: .ConfirmDeleteNo
                    }
                }
            }
            if .body != "" {
                div (style: "fields flex flex-col p-4 bg-card rounded-xl border border-border") {
                    for e in .entries {
                        div (style: "contents") {
                            key: e.key
                            if e.kind == "subform" {
                                div (style: "subform-header flex flex-row items-center gap-[8px] px-1 pt-[14px] pb-[6px] border-b border-border") {
                                    span (style: "subform-title text-sm font-medium text-foreground", text: e.label) {}
                                    div (style: "flex-1") {}
                                    if e.is_provider {
                                        // OS-014: lucide trash-2 ghost 图标钮——vue 轨 407
                                        // 子节点直通；vm 轨 057 结构子树 content 直绘，
                                        // currentColor 跟随 muted 前景；hover 为 web 增强。
                                        button (style: "btn h-7 w-7 p-1 border-0 rounded-md bg-transparent text-muted-foreground hover:text-[#c42b1c] hover:bg-[#c42b1c]/10 flex items-center justify-center") {
                                            onclick: .AskDelete(e.key)
                                            svg (viewBox: "0 0 24 24", style: "h-4 w-4 shrink-0") {
                                                path (d: "M3 6h18", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round") {}
                                                path (d: "M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round") {}
                                                path (d: "M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2", fill: "none", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round", stroke-linejoin: "round") {}
                                                line (x1: "10", y1: "11", x2: "10", y2: "17", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                                line (x1: "14", y1: "11", x2: "14", y2: "17", stroke: "currentColor", stroke-width: "2", stroke-linecap: "round") {}
                                            }
                                        }
                                    }
                                }
                            }
                            // Plan 559 W6: declared field widgets mount their picker
                            // component instead of the flat input row.
                            if e.kind == "wallpaper_picker" {
                                div (style: "field-row flex flex-row items-center gap-[12px] py-[6px] px-1") {
                                    label (style: "field-label w-[220px] shrink-0 text-xs text-muted-foreground font-medium") {
                                        text (text: e.label) {}
                                    }
                                    WallpaperPicker(module_id: .module_id, field: e.key, dir: .wallpapers_dir, current: e.value) { }
                                }
                            }
                            if e.kind != "subform" && e.kind != "wallpaper_picker" {
                                div (style: "field-row flex flex-row items-center gap-[12px] py-[6px] px-1") {
                                    label (style: "field-label w-[220px] shrink-0 text-xs text-muted-foreground font-medium") {
                                        text (text: e.label) {}
                                    }
                                    // 016 重设计:toggle 由 checkbox 改开/关按钮(vm 轨
                                    // checkbox 不渲染;按钮双轨可靠,激活态 bg-primary)。
                                    if e.kind == "toggle" {
                                        row (style: "toggle flex flex-row items-center rounded-lg bg-muted p-[3px] gap-[3px] w-fit") {
                                            if e.is_on {
                                                button (style: "toggle-on h-7 px-3 text-xs font-medium rounded-md bg-primary text-primary-foreground border-0", text: "开") {
                                                    onclick: .Toggle(e, "true")
                                                }
                                                button (style: "toggle-off h-7 px-3 text-xs rounded-md text-muted-foreground border-0", text: "关") {
                                                    onclick: .Toggle(e, "false")
                                                }
                                            }
                                            if e.is_on == false {
                                                button (style: "toggle-on h-7 px-3 text-xs rounded-md text-muted-foreground border-0", text: "开") {
                                                    onclick: .Toggle(e, "true")
                                                }
                                                button (style: "toggle-off h-7 px-3 text-xs font-medium rounded-md bg-primary text-primary-foreground border-0", text: "关") {
                                                    onclick: .Toggle(e, "false")
                                                }
                                            }
                                        }
                                    }
                                    if e.kind == "number" {
                                        input ("type": "number", value: e.value, style: "input flex-1 h-8 px-2 text-sm text-foreground bg-background border border-border rounded-md") {
                                            oninput: .Draft
                                            onchange: .Apply(e, $event.target.value)
                                        }
                                    }
                                    if e.kind == "password" {
                                        div (style: "secret flex flex-row items-center gap-[8px] flex-1") {
                                            if .pw_show {
                                                input (value: e.value, "type": "text", placeholder: "(not set)", style: "input pw flex-1 h-8 px-2 text-sm text-foreground bg-background border border-border rounded-md") {
                                                    oninput: .Draft
                                                    onchange: .Apply(e, $event.target.value)
                                                }
                                            }
                                            if .pw_show == false {
                                                input (value: e.value, "type": "password", placeholder: "(not set)", style: "input pw flex-1 h-8 px-2 text-sm text-foreground bg-background border border-border rounded-md") {
                                                    oninput: .Draft
                                                    onchange: .Apply(e, $event.target.value)
                                                }
                                            }
                                            button (style: "reveal h-8 px-2 text-xs rounded-md bg-muted text-muted-foreground border-0", text: "👁") {
                                                onclick: .PwToggle
                                            }
                                        }
                                    }
                                    if e.kind == "text" {
                                        input (value: e.value, "type": "text", placeholder: "(empty)", style: "input flex-1 h-8 px-2 text-sm text-foreground bg-background border border-border rounded-md") {
                                            oninput: .Draft
                                            onchange: .Apply(e, $event.target.value)
                                        }
                                    }
                                    // 016 重设计:select 改选项按钮组(vm 轨 select 映射为
                                    // 空壳不渲染 option 子节点);无候选时回退自由文本输入
                                    //(原分支保留)。
                                    if e.kind == "select" {
                                        div (style: "fallback-text flex flex-col gap-[4px] flex-1") {
                                            input (value: e.value, "type": "text", placeholder: "(not set)", style: "input flex-1 h-8 px-2 text-sm text-foreground bg-background border border-border rounded-md") {
                                                oninput: .Draft
                                                onchange: .Apply(e, $event.target.value)
                                            }
                                            span (style: "fallback-hint text-xs text-muted-foreground", text: "free text — accepted values depend on the daemon's provider registry") {}
                                        }
                                    if e.options.len() == 0 {
                                            div (style: "fallback-text flex flex-col gap-[4px] flex-1") {
                                                input (value: e.value, "type": "text", placeholder: "(not set)", style: "input flex-1 h-8 px-2 text-sm text-foreground bg-background border border-border rounded-md") {
                                                    oninput: .Draft
                                                    onchange: .Apply(e, $event.target.value)
                                                }
                                                span (style: "fallback-hint text-xs text-muted-foreground", text: "no options available (e.g. builtin-only) — type freely") {}
                                            }
                                        }
                                    }
                                    if e.kind == "tags" {
                                        div (style: "tags flex flex-row items-center gap-[6px] flex-1") {
                                            for t in e.items {
                                                span (style: "tag") {
                                                    text (text: t) {}
                                                    button (text: "×", style: "tag-x") {
                                                        onclick: .TagRemove(e, t)
                                                    }
                                                }
                                            }
                                            input (value: "", "type": "text", placeholder: "add…", style: "tag-input flex-1 h-7 px-2 text-xs text-foreground bg-background border border-border rounded-md") {
                                                oninput: .Draft
                                                onkeydown.enter: .TagAdd(e)
                                            }
                                        }
                                    }
                                    if e.kind == "multiselect" {
                                        div (style: "multiselect flex flex-row items-center gap-[6px] flex-1") {
                                            if e.options.len() == 0 {
                                                p (style: "ms-empty", text: "No options available (directory empty or missing).") {}
                                            }
                                        }
                                    }
                                    if e.kind == "table" {
                                        // 016 重设计:表格改原语拼装——vm 轨 table 组件的
                                        // th/单元格渲染不可控(表头大色块/单元格不可见),
                                        // 改为标签行 + 输入行的原语网格(列宽对齐),
                                        // 双轨确定性渲染。
                                        col (style: "table-wrap flex flex-col gap-[6px] flex-1") {
                                            row (style: "flex flex-row gap-[8px]") {
                                                for c in e.t_cols {
                                                    span (text: c.name, style: "w-40 text-xs font-medium text-muted-foreground") {}
                                                }
                                            }
                                            for ri, r in e.t_rows {
                                                row (style: "flex flex-row gap-[8px] items-center") {
                                                    for c in e.t_cols {
                                                        input (value: r[c.name], "type": "text", style: "w-40 h-8 px-2 text-xs text-foreground bg-background border border-border rounded-md") {
                                                            onchange: .TableCell(e, ri, c.name, $event.target.value)
                                                        }
                                                    }
                                                    button (text: "×", style: "h-7 px-2 text-xs rounded-md bg-muted text-muted-foreground border-0") {
                                                        onclick: .TableRowRemove(e, ri)
                                                    }
                                                }
                                            }
                                            if e.t_rows.len() == 0 {
                                                text (text: "(empty — click + Row)", style: "text-xs text-muted-foreground") {}
                                            }
                                            row (style: "flex flex-row") {
                                                button (text: "+ Row", style: "add-row h-7 px-3 text-xs rounded-md bg-muted text-muted-foreground border-0") {
                                                    onclick: .TableRowAdd(e)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            .loading = true
            .error = ""
            var r = fetchConfigSafe(.module_id)
            if r.ok {
                .body = r.value
                .wallpapers_dir = cfgField(.body, "cfg_wallpapers_dir")
                .meta_file = metaFile(r.meta)
                .dirty = false
                .loaded_once = true
                .status = "loaded"
                let w = warmEnumsText(.body, .module_id)
                var es = []
                let n = entriesCount(.body)
                var i = 0
                loop {
                    if i >= n {
                        break
                    }
                    es.push(entryAtW(.body, i, .module_id, .widgets))
                    if entryAtW(.body, i, .module_id, .widgets).kind == "subform" {
                        let sc = subCount(entryAtW(.body, i, .module_id, .widgets).frag)
                        var j = 0
                        loop {
                            if j >= sc {
                                break
                            }
                            es.push(subAt(.body, entryAtW(.body, i, .module_id, .widgets).key, j, .module_id))
                            j = j + 1
                        }
                    }
                    i = i + 1
                }
                .entries = es
                .draft = ""
            }
            if r.ok == false {
                .error = "Failed to load config"
            }
            .loading = false
        }

        .Load -> {
            .loading = true
            .error = ""
            var r = fetchConfigSafe(.module_id)
            if r.ok {
                .body = r.value
                .wallpapers_dir = cfgField(.body, "cfg_wallpapers_dir")
                .meta_file = metaFile(r.meta)
                .dirty = false
                .loaded_once = true
                .status = "loaded"
                let w = warmEnumsText(.body, .module_id)
                var es = []
                let n = entriesCount(.body)
                var i = 0
                loop {
                    if i >= n {
                        break
                    }
                    es.push(entryAtW(.body, i, .module_id, .widgets))
                    if entryAtW(.body, i, .module_id, .widgets).kind == "subform" {
                        let sc = subCount(entryAtW(.body, i, .module_id, .widgets).frag)
                        var j = 0
                        loop {
                            if j >= sc {
                                break
                            }
                            es.push(subAt(.body, entryAtW(.body, i, .module_id, .widgets).key, j, .module_id))
                            j = j + 1
                        }
                    }
                    i = i + 1
                }
                .entries = es
                .draft = ""
            }
            if r.ok == false {
                .error = "Failed to load config"
            }
            .loading = false
        }

        .Draft(v str) -> {
            .draft = v
        }

        .NameDraft(v str) -> {
            .new_block_name = v
        }

        .PwToggle -> {
            .pw_show = .pw_show == false
        }

        .Toggle(e, v str) -> {
            .body = editField(.body, e.key, v)
            .dirty = true
            var es = []
            let n = entriesCount(.body)
            var i = 0
            loop {
                if i >= n {
                    break
                }
                es.push(entryAtW(.body, i, .module_id, .widgets))
                if entryAtW(.body, i, .module_id, .widgets).kind == "subform" {
                    let sc = subCount(entryAtW(.body, i, .module_id, .widgets).frag)
                    var j = 0
                    loop {
                        if j >= sc {
                            break
                        }
                        es.push(subAt(.body, entryAtW(.body, i, .module_id, .widgets).key, j, .module_id))
                        j = j + 1
                    }
                }
                i = i + 1
            }
            .entries = es
            .draft = ""
        }

        .Apply(e, v) -> {
            .body = editField(.body, e.key, v)
                .dirty = true
                var es = []
                let n = entriesCount(.body)
                var i = 0
                loop {
                    if i >= n {
                        break
                    }
                    es.push(entryAtW(.body, i, .module_id, .widgets))
                    if entryAtW(.body, i, .module_id, .widgets).kind == "subform" {
                        let sc = subCount(entryAtW(.body, i, .module_id, .widgets).frag)
                        var j = 0
                        loop {
                            if j >= sc {
                                break
                            }
                            es.push(subAt(.body, entryAtW(.body, i, .module_id, .widgets).key, j, .module_id))
                            j = j + 1
                        }
                    }
                    i = i + 1
                }
                .entries = es
                .draft = ""
        }

        .TagAdd(e) -> {
            if .draft != "" {
                .body = editTagField(.body, e.key, .draft, "")
                .dirty = true
                var es = []
                let n = entriesCount(.body)
                var i = 0
                loop {
                    if i >= n {
                        break
                    }
                    es.push(entryAtW(.body, i, .module_id, .widgets))
                    if entryAtW(.body, i, .module_id, .widgets).kind == "subform" {
                        let sc = subCount(entryAtW(.body, i, .module_id, .widgets).frag)
                        var j = 0
                        loop {
                            if j >= sc {
                                break
                            }
                            es.push(subAt(.body, entryAtW(.body, i, .module_id, .widgets).key, j, .module_id))
                            j = j + 1
                        }
                    }
                    i = i + 1
                }
                .entries = es
                .draft = ""
            }
        }

        .TagRemove(e, t) -> {
            .body = editTagField(.body, e.key, "", t)
            .dirty = true
            var es = []
            let n = entriesCount(.body)
            var i = 0
            loop {
                if i >= n {
                    break
                }
                es.push(entryAtW(.body, i, .module_id, .widgets))
                if entryAtW(.body, i, .module_id, .widgets).kind == "subform" {
                    let sc = subCount(entryAtW(.body, i, .module_id, .widgets).frag)
                    var j = 0
                    loop {
                        if j >= sc {
                            break
                        }
                        es.push(subAt(.body, entryAtW(.body, i, .module_id, .widgets).key, j, .module_id))
                        j = j + 1
                    }
                }
                i = i + 1
            }
            .entries = es
            .draft = ""
        }

        .TableCell(e, ri, col, v) -> {
            .body = setCellText(.body, e.key, ri, col, v)
            .dirty = true
            var es = []
            let n = entriesCount(.body)
            var i = 0
            loop {
                if i >= n {
                    break
                }
                es.push(entryAtW(.body, i, .module_id, .widgets))
                if entryAtW(.body, i, .module_id, .widgets).kind == "subform" {
                    let sc = subCount(entryAtW(.body, i, .module_id, .widgets).frag)
                    var j = 0
                    loop {
                        if j >= sc {
                            break
                        }
                        es.push(subAt(.body, entryAtW(.body, i, .module_id, .widgets).key, j, .module_id))
                        j = j + 1
                    }
                }
                i = i + 1
            }
            .entries = es
            .draft = ""
        }

        .TableRowAdd(e) -> {
            .body = tableAddRowText(.body, e.key)
            .dirty = true
            var es = []
            let n = entriesCount(.body)
            var i = 0
            loop {
                if i >= n {
                    break
                }
                es.push(entryAtW(.body, i, .module_id, .widgets))
                if entryAtW(.body, i, .module_id, .widgets).kind == "subform" {
                    let sc = subCount(entryAtW(.body, i, .module_id, .widgets).frag)
                    var j = 0
                    loop {
                        if j >= sc {
                            break
                        }
                        es.push(subAt(.body, entryAtW(.body, i, .module_id, .widgets).key, j, .module_id))
                        j = j + 1
                    }
                }
                i = i + 1
            }
            .entries = es
            .draft = ""
        }

        .TableRowRemove(e, ri) -> {
            .body = tableRemoveRowText(.body, e.key, ri)
            .dirty = true
            var es = []
            let n = entriesCount(.body)
            var i = 0
            loop {
                if i >= n {
                    break
                }
                es.push(entryAtW(.body, i, .module_id, .widgets))
                if entryAtW(.body, i, .module_id, .widgets).kind == "subform" {
                    let sc = subCount(entryAtW(.body, i, .module_id, .widgets).frag)
                    var j = 0
                    loop {
                        if j >= sc {
                            break
                        }
                        es.push(subAt(.body, entryAtW(.body, i, .module_id, .widgets).key, j, .module_id))
                        j = j + 1
                    }
                }
                i = i + 1
            }
            .entries = es
            .draft = ""
        }

        .Save -> {
            if .dirty && .body != "" {
                if .save_acked {
                    .saving = true
                    .status = "saving…"
                    var r = putConfigSafe(.module_id, .body)
                    if r.ok {
                        .dirty = false
                        .status = "saved ✓"
                    }
                    if r.ok == false {
                        .status = "save failed"
                        .error = r.error
                    }
                    .saving = false
                }
                if .save_acked == false {
                    .confirm_save = true
                }
            }
        }

        .ConfirmSaveYes -> {
            .confirm_save = false
            .save_acked = true
            .saving = true
            .status = "saving…"
            var r = putConfigSafe(.module_id, .body)
            if r.ok {
                .dirty = false
                .status = "saved ✓"
            }
            if r.ok == false {
                .status = "save failed"
                .error = r.error
            }
            .saving = false
        }

        .ConfirmSaveNo -> {
            .confirm_save = false
        }

        .ToggleAddBlock -> {
            .adding_block = .adding_block == false
            .block_error = ""
        }

        .AddBlock -> {
            var name = .new_block_name.trim()
            if name != "" {
                if bodyHasText(.body, name) {
                    .block_error = "\"" + name + "\" already exists in this config"
                }
                if bodyHasText(.body, name) == false {
                    .body = addBlockText(.body, name)
                    .dirty = true
                    .new_block_name = ""
                    .adding_block = false
                    .block_error = ""
                    var es = []
                    let n = entriesCount(.body)
                    var i = 0
                    loop {
                        if i >= n {
                            break
                        }
                        es.push(entryAtW(.body, i, .module_id, .widgets))
                        if entryAtW(.body, i, .module_id, .widgets).kind == "subform" {
                            let sc = subCount(entryAtW(.body, i, .module_id, .widgets).frag)
                            var j = 0
                            loop {
                                if j >= sc {
                                    break
                                }
                                es.push(subAt(.body, entryAtW(.body, i, .module_id, .widgets).key, j, .module_id))
                                j = j + 1
                            }
                        }
                        i = i + 1
                    }
                    .entries = es
                    .draft = ""
                }
            }
        }

        .CancelAddBlock -> {
            .adding_block = false
            .new_block_name = ""
            .block_error = ""
        }

        .AskDelete(name) -> {
            .confirm_del = name
        }

        .ConfirmDeleteYes -> {
            var r = deleteBlockSafe(.module_id, .confirm_del)
            .confirm_del = ""
            if r.ok {
                .block_error = ""
                var q = fetchConfigSafe(.module_id)
                if q.ok {
                    .body = q.value
                    .meta_file = metaFile(q.meta)
                    .dirty = false
                    var es = []
                    let n = entriesCount(.body)
                    var i = 0
                    loop {
                        if i >= n {
                            break
                        }
                        es.push(entryAtW(.body, i, .module_id, .widgets))
                        if entryAtW(.body, i, .module_id, .widgets).kind == "subform" {
                            let sc = subCount(entryAtW(.body, i, .module_id, .widgets).frag)
                            var j = 0
                            loop {
                                if j >= sc {
                                    break
                                }
                                es.push(subAt(.body, entryAtW(.body, i, .module_id, .widgets).key, j, .module_id))
                                j = j + 1
                            }
                        }
                        i = i + 1
                    }
                    .entries = es
                    .draft = ""
                }
                if q.ok == false {
                    .error = q.error
                }
            }
            if r.ok == false {
                .block_error = "Delete failed"
            }
        }

        .ConfirmDeleteNo -> {
            .confirm_del = ""
        }
    }
}
