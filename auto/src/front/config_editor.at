// config_editor.at — the unified generic config editor (Plan 008 Phase 3
// batch 3; 2026-08-27 视图层回归 CSS 原版形态——像素对拍基准).
//
// Architecture: the vm TEXT pipeline is the canonical contract
// (fetch/editField/editTagField over the body as a JSON string — api.ts
// mirrors every fn). The entry list is FLAT: subform fields are interleaved
// right after their subform row (subAt, dotted keys, depth=1) — no nested
// arrays in model maps (VG flat-return discipline), handler reads stay
// chain-direct off fn calls (VG4), and there are NO handler-to-handler msg
// calls (rebuild/save flows are inlined per site).
//
// 2026-08-27 视图对拍（css-era ConfigEditor/ScalarFields 1:1）：
//   - DOM 结构与命名类回归 css-era（toolbar/meta/actions/btn/field-row/
//     field-label/subform-*/input/toggle/secret…）；这些类由 styles.css 的
//     「.config-editor 复刻块」实现（css-era scoped CSS 原值拷贝，含伪类——
//     Tailwind 类串表达不了 input:checked + .toggle-track 这类选择器）；
//     vm 端命名类本就是惰性钩子；
//   - Init 消息回归：vue codegen → onMounted 自动加载（css-era 行为），
//     无 Load 按钮；vm 子组件无 auto-Init → Load 按钮只在 vm 出现；
//   - 编辑提交：输入 oninput 存 draft，onchange（失焦/回车）提交——视觉上
//     无 css-era 所无的 Apply 按钮（css-era 是逐键 live-apply，登记偏差）；
//   - Save 按钮 disabled: !dirty || saving（css-era 半透明禁用态还原）；
//   - subform 盒由平铺行拼装：header 行全边框，子行 subform-cont 补左右
//     边、末行补底边+下圆角（first/last 标记由 api.at subAt 预计算）；
//   - 已登记的降级残留（待后续批次还原）：select 暂为自由文本（枚举选项
//     管线未建）、tags/multiselect 暂为加号式（chips 未还原）、table 暂为
//     只读 JSON（可编辑表格未还原）、confirm 行内化（vm 无 window.confirm）。
use back.api: fetchConfigSafe, putConfigSafe, deleteBlockSafe, entriesCount, entryAt, subCount, subAt, editField, editTagField, addBlockText, bodyHasText, metaFile

widget ConfigEditor(module_id: str) {
    msg Msg {
        Init,
        Load,
        Save,
        ConfirmSaveYes,
        ConfirmSaveNo,
        Draft(str),
        NameDraft(str),
        Apply(map, str),
        TagAdd(map),
        Toggle(map, bool),
        PwToggle,
        ToggleAddBlock,
        AddBlock,
        CancelAddBlock,
        AskDelete(str),
        ConfirmDeleteYes,
        ConfirmDeleteNo
    }

    model {
        var body str = ""
        var entries Array<str> = []
        var loading bool = false
        var error str = ""
        var dirty bool = false
        var saving bool = false
        var status str = ""
        var loaded_once bool = false
        var draft str = ""
        var pw_show bool = false
        var meta_file str = ""
        var adding_block bool = false
        var new_block_name str = ""
        var block_error str = ""
        var confirm_save bool = false
        var save_acked bool = false
        var confirm_del str = ""
    }

    view {
        div (style: "config-editor max-w-[820px] gap-[0px]") {
            if .loading {
                div (style: "state-msg") {
                    text (text: "Loading…") {}
                }
            }
            if .loading == false && .error != "" && .body == "" {
                div (style: "state-msg error") {
                    text (text: "✗ " + .error) {}
                    span (style: "hint") {
                        text (text: "Is the config daemon running on :17701?") {}
                    }
                }
            }
            div (style: "toolbar gap-[0px]") {
                div (style: "meta gap-[0px]") {
                    span (style: "mono", text: .meta_file) {}
                    if .dirty {
                        span (style: "dirty", text: "● unsaved") {}
                    }
                }
                div (style: "actions gap-[0px]") {
                    if .block_error != "" {
                        span (style: "block-error", text: .block_error) {}
                    }
                    if .adding_block {
                        input (style: "block-name", placeholder: "block name", value: .new_block_name) {
                            oninput: .NameDraft
                            onkeydown.enter: .AddBlock
                        }
                        button (style: "btn", text: "Add") {
                            onclick: .AddBlock
                        }
                        button (style: "btn", text: "Cancel") {
                            onclick: .CancelAddBlock
                        }
                    }
                    if .adding_block == false {
                        if .loaded_once {
                            button (style: "btn", text: "＋ Add block") {
                                onclick: .ToggleAddBlock
                            }
                        }
                    }
                    if .loaded_once {
                        button (style: "btn", text: "Reload", disabled: .saving) {
                            onclick: .Load
                        }
                        button (style: "btn primary", disabled: .saving || .dirty == false) {
                            onclick: .Save
                            if .saving {
                                text (text: "Saving…") {}
                            }
                            if .saving == false {
                                text (text: "Save") {}
                            }
                        }
                    }
                    if .loaded_once == false {
                        button (style: "btn", text: "Load") {
                            onclick: .Load
                        }
                    }
                }
            }
            if .confirm_save {
                row (style: "flex items-center gap-3 px-3 py-2 border border-[#e0e0e0] rounded bg-[#ededed]") {
                    text (text: "Save changes to disk? (.bak backup kept)", style: "text-sm text-[#1a1a1a]") {}
                    div (style: "flex-1") {}
                    button (text: "Yes, save", style: "btn px-3 py-1 text-xs rounded bg-primary border-primary text-white") {
                        onclick: .ConfirmSaveYes
                    }
                    button (text: "Cancel", style: "btn px-3 py-1 text-xs rounded border border-[#e0e0e0] bg-white") {
                        onclick: .ConfirmSaveNo
                    }
                }
            }
            if .confirm_del != "" {
                row (style: "flex items-center gap-3 px-3 py-2 border border-[#c42b1c] rounded bg-[#ededed]") {
                    text (text: "Delete block " + .confirm_del + "? (.bak kept)", style: "text-sm text-[#c42b1c]") {}
                    div (style: "flex-1") {}
                    button (text: "Yes, delete", style: "btn px-3 py-1 text-xs rounded bg-[#c42b1c] border-[#c42b1c] text-white") {
                        onclick: .ConfirmDeleteYes
                    }
                    button (text: "Cancel", style: "btn px-3 py-1 text-xs rounded border border-[#e0e0e0] bg-white") {
                        onclick: .ConfirmDeleteNo
                    }
                }
            }
            if .body != "" {
                div (style: "fields gap-[0px]") {
                    for e in .entries {
                        div (style: "contents") {
                            key: e.key
                            if e.kind == "subform" {
                                div (style: "subform-header gap-[0px]") {
                                    span (style: "subform-title", text: e.label) {}
                                    if e.is_provider {
                                        button (style: "btn danger btn-sm", text: "🗑") {
                                            onclick: .AskDelete(e.key)
                                        }
                                    }
                                }
                            }
                            if e.kind != "subform" {
                                div (class: e.box_class) {
                                    label (style: "field-label") {
                                        text (text: e.label) {}
                                    }
                                    if e.kind == "toggle" {
                                        label (style: "toggle gap-[0px]") {
                                            input ("type": "checkbox", checked: e.is_on) {
                                                onchange: .Toggle(e, $event.target.checked)
                                            }
                                            span (style: "toggle-track") {
                                                span (style: "toggle-thumb") {}
                                            }
                                            span (style: "toggle-text") {
                                                if e.value == "true" {
                                                    text (text: "On") {}
                                                }
                                                if e.value != "true" {
                                                    text (text: "Off") {}
                                                }
                                            }
                                        }
                                    }
                                    if e.kind == "number" {
                                        input ("type": "number", value: e.value, style: "input") {
                                            oninput: .Draft
                                            onchange: .Apply(e, $event.target.value)
                                        }
                                    }
                                    if e.kind == "password" {
                                        div (style: "secret gap-[0px]") {
                                            if .pw_show {
                                                input (value: e.value, "type": "text", placeholder: "(not set)", style: "input pw") {
                                                    oninput: .Draft
                                                    onchange: .Apply(e, $event.target.value)
                                                }
                                            }
                                            if .pw_show == false {
                                                input (value: e.value, "type": "password", placeholder: "(not set)", style: "input pw") {
                                                    oninput: .Draft
                                                    onchange: .Apply(e, $event.target.value)
                                                }
                                            }
                                            button (style: "reveal", text: "👁") {
                                                onclick: .PwToggle
                                            }
                                        }
                                    }
                                    if e.kind == "text" {
                                        input (value: e.value, "type": "text", placeholder: "(empty)", style: "input") {
                                            oninput: .Draft
                                            onchange: .Apply(e, $event.target.value)
                                        }
                                    }
                                    if e.kind == "select" {
                                        input (value: e.value, "type": "text", placeholder: "(not set)", style: "input") {
                                            oninput: .Draft
                                            onchange: .Apply(e, $event.target.value)
                                        }
                                    }
                                    if e.kind == "tags" {
                                        div (style: "flex items-center gap-2") {
                                            input (value: "", "type": "text", placeholder: "add…", style: "input tag-input") {
                                                oninput: .Draft
                                            }
                                            button (style: "btn", text: "Add") {
                                                onclick: .TagAdd(e)
                                            }
                                        }
                                    }
                                    if e.kind == "multiselect" {
                                        div (style: "flex items-center gap-2") {
                                            input (value: "", "type": "text", placeholder: "add…", style: "input tag-input") {
                                                oninput: .Draft
                                            }
                                            button (style: "btn", text: "Add") {
                                                onclick: .TagAdd(e)
                                            }
                                        }
                                    }
                                    if e.kind == "table" {
                                        div (style: "table-readonly") {
                                            text (text: e.frag, style: "font-mono text-xs text-[#616161] whitespace-pre-wrap break-all") {}
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                div (style: "toolbar bottom gap-[0px]") {
                    div (style: "actions gap-[0px]") {
                        button (style: "btn primary", disabled: .saving || .dirty == false) {
                            onclick: .Save
                            if .saving {
                                text (text: "Saving…") {}
                            }
                            if .saving == false {
                                text (text: "Save") {}
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            .loading = true
            .error = ""
            var r = fetchConfigSafe(.module_id)
            if r.ok {
                .body = r.value
                .meta_file = metaFile(r.meta)
                .dirty = false
                .loaded_once = true
                .status = "loaded"
                var es = []
                let n = entriesCount(.body)
                var i = 0
                loop {
                    if i >= n {
                        break
                    }
                    es.push(entryAt(.body, i, .module_id))
                    if entryAt(.body, i, .module_id).kind == "subform" {
                        let sc = subCount(entryAt(.body, i, .module_id).frag)
                        var j = 0
                        loop {
                            if j >= sc {
                                break
                            }
                            es.push(subAt(.body, entryAt(.body, i, .module_id).key, j, .module_id))
                            j = j + 1
                        }
                    }
                    i = i + 1
                }
                .entries = es
                .draft = ""
            }
            if r.ok == false {
                .error = "Failed to load config"
            }
            .loading = false
        }

        .Load -> {
            .loading = true
            .error = ""
            var r = fetchConfigSafe(.module_id)
            if r.ok {
                .body = r.value
                .meta_file = metaFile(r.meta)
                .dirty = false
                .loaded_once = true
                .status = "loaded"
                var es = []
                let n = entriesCount(.body)
                var i = 0
                loop {
                    if i >= n {
                        break
                    }
                    es.push(entryAt(.body, i, .module_id))
                    if entryAt(.body, i, .module_id).kind == "subform" {
                        let sc = subCount(entryAt(.body, i, .module_id).frag)
                        var j = 0
                        loop {
                            if j >= sc {
                                break
                            }
                            es.push(subAt(.body, entryAt(.body, i, .module_id).key, j, .module_id))
                            j = j + 1
                        }
                    }
                    i = i + 1
                }
                .entries = es
                .draft = ""
            }
            if r.ok == false {
                .error = "Failed to load config"
            }
            .loading = false
        }

        .Draft(v str) -> {
            .draft = v
        }

        .NameDraft(v str) -> {
            .new_block_name = v
        }

        .PwToggle -> {
            .pw_show = .pw_show == false
        }

        .Toggle(e, on) -> {
            var nv = "false"
            if on {
                nv = "true"
            }
            .body = editField(.body, e.key, nv)
            .dirty = true
            var es = []
            let n = entriesCount(.body)
            var i = 0
            loop {
                if i >= n {
                    break
                }
                es.push(entryAt(.body, i, .module_id))
                if entryAt(.body, i, .module_id).kind == "subform" {
                    let sc = subCount(entryAt(.body, i, .module_id).frag)
                    var j = 0
                    loop {
                        if j >= sc {
                            break
                        }
                        es.push(subAt(.body, entryAt(.body, i, .module_id).key, j, .module_id))
                        j = j + 1
                    }
                }
                i = i + 1
            }
            .entries = es
            .draft = ""
        }

        .Apply(e, v) -> {
            .body = editField(.body, e.key, v)
                .dirty = true
                var es = []
                let n = entriesCount(.body)
                var i = 0
                loop {
                    if i >= n {
                        break
                    }
                    es.push(entryAt(.body, i, .module_id))
                    if entryAt(.body, i, .module_id).kind == "subform" {
                        let sc = subCount(entryAt(.body, i, .module_id).frag)
                        var j = 0
                        loop {
                            if j >= sc {
                                break
                            }
                            es.push(subAt(.body, entryAt(.body, i, .module_id).key, j, .module_id))
                            j = j + 1
                        }
                    }
                    i = i + 1
                }
                .entries = es
                .draft = ""
        }

        .TagAdd(e) -> {
            if .draft != "" {
                .body = editTagField(.body, e.key, .draft, "")
                .dirty = true
                var es = []
                let n = entriesCount(.body)
                var i = 0
                loop {
                    if i >= n {
                        break
                    }
                    es.push(entryAt(.body, i, .module_id))
                    if entryAt(.body, i, .module_id).kind == "subform" {
                        let sc = subCount(entryAt(.body, i, .module_id).frag)
                        var j = 0
                        loop {
                            if j >= sc {
                                break
                            }
                            es.push(subAt(.body, entryAt(.body, i, .module_id).key, j, .module_id))
                            j = j + 1
                        }
                    }
                    i = i + 1
                }
                .entries = es
                .draft = ""
            }
        }

        .Save -> {
            if .dirty && .body != "" {
                if .save_acked {
                    .saving = true
                    .status = "saving…"
                    var r = putConfigSafe(.module_id, .body)
                    if r.ok {
                        .dirty = false
                        .status = "saved ✓"
                    }
                    if r.ok == false {
                        .status = "save failed"
                        .error = r.error
                    }
                    .saving = false
                }
                if .save_acked == false {
                    .confirm_save = true
                }
            }
        }

        .ConfirmSaveYes -> {
            .confirm_save = false
            .save_acked = true
            .saving = true
            .status = "saving…"
            var r = putConfigSafe(.module_id, .body)
            if r.ok {
                .dirty = false
                .status = "saved ✓"
            }
            if r.ok == false {
                .status = "save failed"
                .error = r.error
            }
            .saving = false
        }

        .ConfirmSaveNo -> {
            .confirm_save = false
        }

        .ToggleAddBlock -> {
            .adding_block = .adding_block == false
            .block_error = ""
        }

        .AddBlock -> {
            var name = .new_block_name.trim()
            if name != "" {
                if bodyHasText(.body, name) {
                    .block_error = "\"" + name + "\" already exists in this config"
                }
                if bodyHasText(.body, name) == false {
                    .body = addBlockText(.body, name)
                    .dirty = true
                    .new_block_name = ""
                    .adding_block = false
                    .block_error = ""
                    var es = []
                    let n = entriesCount(.body)
                    var i = 0
                    loop {
                        if i >= n {
                            break
                        }
                        es.push(entryAt(.body, i, .module_id))
                        if entryAt(.body, i, .module_id).kind == "subform" {
                            let sc = subCount(entryAt(.body, i, .module_id).frag)
                            var j = 0
                            loop {
                                if j >= sc {
                                    break
                                }
                                es.push(subAt(.body, entryAt(.body, i, .module_id).key, j, .module_id))
                                j = j + 1
                            }
                        }
                        i = i + 1
                    }
                    .entries = es
                    .draft = ""
                }
            }
        }

        .CancelAddBlock -> {
            .adding_block = false
            .new_block_name = ""
            .block_error = ""
        }

        .AskDelete(name) -> {
            .confirm_del = name
        }

        .ConfirmDeleteYes -> {
            var r = deleteBlockSafe(.module_id, .confirm_del)
            .confirm_del = ""
            if r.ok {
                .block_error = ""
                var q = fetchConfigSafe(.module_id)
                if q.ok {
                    .body = q.value
                    .meta_file = metaFile(q.meta)
                    .dirty = false
                    var es = []
                    let n = entriesCount(.body)
                    var i = 0
                    loop {
                        if i >= n {
                            break
                        }
                        es.push(entryAt(.body, i, .module_id))
                        if entryAt(.body, i, .module_id).kind == "subform" {
                            let sc = subCount(entryAt(.body, i, .module_id).frag)
                            var j = 0
                            loop {
                                if j >= sc {
                                    break
                                }
                                es.push(subAt(.body, entryAt(.body, i, .module_id).key, j, .module_id))
                                j = j + 1
                            }
                        }
                        i = i + 1
                    }
                    .entries = es
                    .draft = ""
                }
                if q.ok == false {
                    .error = q.error
                }
            }
            if r.ok == false {
                .block_error = "Delete failed"
            }
        }

        .ConfirmDeleteNo -> {
            .confirm_del = ""
        }
    }
}
