// api.at — auto-os-config-back 契约层(Plan 011 T2)。
//
// 外部 back 根(Plan 061):前端 auto/pac.at `back: { project: "../auto-os-config-back" }`
// 使 vm merged 模式把 `back.api` 解析到本文件;vue 轨不受影响(resolve_back_api
// 本地 src/back/api.at 优先,regen 行为不变)。
//
// 本文从前端 auto/src/back/api.at 反向提取(56 pub fn 签名逐字稳定——前端
// `use back.api:` 导出行是契约,零改动)。分两类:
//   - 纯文本手术/投影 helpers:与前端版逐字相同(vm 解释执行,已实证);
//   - daemon I/O fns(T4-T7 逐组移植):stub 返回契约形状的 not-migrated 失败,
//     视图 fail-soft 显示;移植完成一个组,对应 fn 改为 #[api] + 桥/直连实现。
//
// 编码基线沿用 probe-V1/V3 文本配方(前端版头注):
//   - JSON 以序列化文本片段流转;显示串不带引号
//   - 禁 `use auto.str`(VG1)/数组 concat(VG5)/闭包 find(VG14)
//   - vm 语法红线清单见 auto/README §vm 编码规范

// ─── transport base(T7 前仍服务 enum 链;T7 后随 enum 桥接退役)─────────────

pub fn daemon_base() str {
    let override = Env.get("AUTOOS_DAEMON")
    if override != "" {
        return override
    }
    return "http://127.0.0.1:17701"
}

/// GET returning raw JSON text, or "" when the response is not valid JSON of
/// any kind (daemon down returns an {"error":...} object — still text).
fn get_text(url str) str {
    let t = http.get_json(url)
    let ttype = json.type_of(t)
    if ttype == "invalid" {
        return ""
    }
    return t
}

/// An {"error": ...} transport-failure body (daemon down) — shape-verified.
fn is_transport_error(t str) bool {
    if t == "" {
        return true
    }
    let ttype = json.type_of(t)
    if ttype != "object" {
        return false
    }
    let ks = json.keys(t)
    if ks.len() != 1 {
        return false
    }
    for k in ks {
        if k == "error" {
            return true
        }
    }
    return false
}

// ─── string helpers ─────────────────────────────────────────────────────────

pub fn unquote(v str) str {
    let n = v.len()
    if n >= 2 {
        let head = v.substr(0, 1)
        let tail = v.substr(n - 1, n)
        if head == "\"" && tail == "\"" {
            return v.substr(1, n - 2)
        }
    }
    return v
}

/// JSON-escape a user string and wrap it as a serialized fragment.
fn quote_json(s str) str {
    let esc = s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "")
    return "\"" + esc + "\""
}

/// A user-entered string as a value fragment, preserving numeric type when
/// the old fragment was a number and the new text is all digits.
fn new_value_fragment(old_frag str, new_str str) str {
    let old_type = json.type_of(old_frag)
    let digits = "0123456789-."
    var all_digits = new_str != ""
    var ci = 0
    loop {
        if ci >= new_str.len() {
            break
        }
        let c = new_str.substr(ci, ci + 1)
        if digits.contains(c) == false {
            all_digits = false
        }
        ci = ci + 1
    }
    if old_type == "number" && all_digits {
        return new_str
    }
    if old_type == "bool" {
        if new_str == "true" || new_str == "false" {
            return new_str
        }
    }
    return quote_json(new_str)
}

pub fn humanize(key str) str {
    let parts = key.split("_")
    var out = ""
    for p in parts {
        if p != "" {
            if out != "" {
                out = out + " "
            }
            out = out + p.substr(0, 1).to_upper() + p.substr(1, p.len())
        }
    }
    return out
}

/// SECRET_RE word-segment equivalent: (^|_)(api_key|key|secret|token|password)(_|$)
fn is_secret_key(k str) bool {
    let lower = k.to_lower()
    let parts = lower.split("_")
    for p in parts {
        if p == "api_key" || p == "key" || p == "secret" || p == "token" || p == "password" {
            return true
        }
    }
    return false
}

// ─── inference engine (types.ts port, text edition) ─────────────────────────

/// FieldSpec: { key, kind, label, ek ("",tiers,dir,self-providers,self-models),
///              ew (dir which), ep (provider) } — optionsFrom flattened.
pub fn inferField(key str, frag str, module_id str, provider_ctx str) any {
    let label = humanize(key)
    let t = json.type_of(frag)
    // 1. structural
    if t == "array" {
        if json.len(frag) > 0 && json.type_of(json.get_at(frag, 0)) == "object" {
            return { key: key, kind: "table", label: label, ek: "", ew: "", ep: "" }
        }
        if key == "roles" || key == "skills" || key == "modes" {
            return { key: key, kind: "multiselect", label: label, ek: "dir", ew: key, ep: "" }
        }
        return { key: key, kind: "tags", label: label, ek: "", ew: "", ep: "" }
    }
    if t == "object" {
        return { key: key, kind: "subform", label: label, ek: "", ew: "", ep: "" }
    }
    // 2. scalar conventions
    if t == "bool" {
        return { key: key, kind: "toggle", label: label, ek: "", ew: "", ep: "" }
    }
    if t == "number" {
        return { key: key, kind: "number", label: label, ek: "", ew: "", ep: "" }
    }
    if is_secret_key(key) {
        return { key: key, kind: "password", label: label, ek: "", ew: "", ep: "" }
    }
    if key == "tier" || key == "model_tier" {
        return { key: key, kind: "select", label: label, ek: "tiers", ew: "", ep: "" }
    }
    if key == "default_provider" {
        return { key: key, kind: "select", label: label, ek: "self-providers", ew: "", ep: "" }
    }
    if key == "default_mode" {
        return { key: key, kind: "select", label: label, ek: "dir", ew: "modes", ep: "" }
    }
    if key == "default_model" && provider_ctx != "" {
        return { key: key, kind: "select", label: label, ek: "self-models", ew: "", ep: provider_ctx }
    }
    return { key: key, kind: "text", label: label, ek: "", ew: "", ep: "" }
}

/// Display value for an input bound in the view: unquoted scalar.
pub fn displayOf(frag str) str {
    let t = json.type_of(frag)
    if t == "string" {
        return unquote(frag)
    }
    if t == "null" {
        return ""
    }
    return frag
}

pub fn enumUrlOfEk(ek str, ew str, module_id str, provider str) str {
    if ek == "tiers" {
        return daemon_base() + "/api/enums/tiers"
    }
    if ek == "dir" {
        return daemon_base() + "/api/enums/dir/" + ew
    }
    if ek == "self-providers" {
        return daemon_base() + "/api/enums/self/" + module_id + "/providers"
    }
    if ek == "self-models" {
        return daemon_base() + "/api/enums/self/" + module_id + "/models/" + provider
    }
    return ""
}

/// Options list [{value,label}] from an enum URL (fail-soft → []).
pub fn loadEnum(url str) []any {
    var out = []
    if url == "" {
        return out
    }
    let t = get_text(url)
    if is_transport_error(t) {
        return out
    }
    if json.type_of(t) != "array" {
        return out
    }
    let n = json.len(t)
    var i = 0
    loop {
        if i >= n {
            break
        }
        let opt = json.get_at(t, i)
        let v = unquote(json.get(opt, "value"))
        let l = unquote(json.get(opt, "label"))
        out.push({ value: v, label: l })
        i = i + 1
    }
    return out
}

/// ── 2026-08-27 像素对拍二阶段：select 真下拉 / tags chips / 可编辑表格 ──
/// 提交时机与缓存：entryAt 每次重建都会同步 loadEnum（本地 daemon，量小可接受）；
/// vue 端由 api.ts warmEnums 在 Init 时预热 enumCache 后同步读缓存。

/// select 条目的选项列表（非 select 或无枚举 → []）。
fn selectOptionsOf(spec any, module_id str) []any {
    var out = []
    if spec.kind == "select" {
        out = loadEnum(enumUrlOfEk(spec.ek, spec.ew, module_id, spec.ep))
    }
    return out
}

/// options 的 value 里是否已含 val（css-era has_current：不含才追加 "(current)"）。
fn optionValuesHave(opts []any, val str) bool {
    for o in opts {
        if o.value == val {
            return true
        }
    }
    return false
}

/// multiselect 复选框的勾选态平行数组（视图无 contains，api 预计算）。
fn msCheckedOf(items []str, opts []any) []bool {
    var out = []
    for o in opts {
        var hit = false
        for t in items {
            if t == o.value {
                hit = true
            }
        }
        out.push(hit)
    }
    return out
}

/// tags/multiselect 的字符串元素（原生数组，视图可直接 for 循环）。
fn stringItemsOf(frag str) []str {
    var out = []
    if json.type_of(frag) == "array" {
        let n = json.len(frag)
        var i = 0
        loop {
            if i >= n {
                break
            }
            out.push(displayOf(json.get_at(frag, i)))
            i = i + 1
        }
    }
    return out
}

/// 表格列描述（css-era tableInfo+mergeCols 等价）：去重保序；kind 强制标量
/// （inferColumn 语义：嵌套 object/array → text）；枚举列 options 同步取。
pub fn tableColsOf(frag str, module_id str) []any {
    var cols = []
    if json.type_of(frag) != "array" {
        return cols
    }
    let n = json.len(frag)
    var i = 0
    loop {
        if i >= n {
            break
        }
        let row = json.get_at(frag, i)
        if json.type_of(row) != "object" {
            i = i + 1
        } else {
            let ks = json.keys(row)
            for k in ks {
                let kn = unquote(k)
                var seen = false
                for c in cols {
                    if c.name == kn {
                        seen = true
                    }
                }
                if seen == false {
                    let sample = json.get(row, kn)
                    let spec = inferField(kn, sample, module_id, "")
                    var kind = spec.kind
                    if spec.kind == "table" || spec.kind == "subform" {
                        kind = "text"
                    }
                    var opts = []
                    if spec.ek != "" {
                        opts = loadEnum(enumUrlOfEk(spec.ek, spec.ew, module_id, spec.ep))
                    }
                    cols.push({ name: kn, kind: kind, options: opts })
                }
            }
            i = i + 1
        }
    }
    return cols
}

/// Init 预热（vm 同步；vue 端孪生是 async，走 await）。
pub fn warmEnumsText(body str, module_id str) bool {
    let n = entriesCount(body)
    var i = 0
    loop {
        if i >= n {
            break
        }
        let e = entryAt(body, i, module_id)
        if e.kind == "table" {
            tableColsOf(e.frag, module_id)
        }
        if e.kind == "subform" {
            let sc = subCount(e.frag)
            var j = 0
            loop {
                if j >= sc {
                    break
                }
                let sub = subAt(body, e.key, j, module_id)
                if sub.is_table {
                    tableColsOf(sub.frag, module_id)
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return true
}

/// depth≤2 的片段取值（editField 的读半边）。
fn fragAt(body str, path str) str {
    let parts = path.split(".")
    if parts.len() == 1 {
        return json.get(body, path)
    }
    return json.get(json.get(body, parts[0]), parts[1])
}

/// 数组片段整体重建（保留其余元素原文）。
fn arrayReplaced(arr str, i int, newRow str) str {
    let n = json.len(arr)
    var out = "["
    var k = 0
    loop {
        if k >= n {
            break
        }
        if k > 0 {
            out = out + ","
        }
        if k == i {
            out = out + newRow
        } else {
            out = out + json.get_at(arr, k)
        }
        k = k + 1
    }
    return out + "]"
}

/// 表格单元格整改（css-era setCell：按旧单元格类型重定型后整片替换）。
pub fn setCellText(body str, path str, i int, col str, v str) str {
    let arr = fragAt(body, path)
    if json.type_of(arr) != "array" {
        return body
    }
    if i >= json.len(arr) {
        return body
    }
    let row = json.get_at(arr, i)
    let nv = new_value_fragment(json.get(row, col), v)
    let row2 = set_obj_field(row, col, nv)
    return setBodyField(body, path, arrayReplaced(arr, i, row2))
}

/// 追加空行（css-era blankRow：按现有列全集补 ""；空表 → {}）。
pub fn tableAddRowText(body str, path str) str {
    let arr = fragAt(body, path)
    if json.type_of(arr) != "array" {
        return body
    }
    let cols = tableColsOf(arr, "add-row")
    var row = "{"
    var first = true
    for c in cols {
        if first == false {
            row = row + ","
        }
        first = false
        row = row + quote_json(c.name) + ":" + quote_json("")
    }
    row = row + "}"
    var out = arr
    if json.len(arr) > 0 {
        out = arr.substr(0, arr.len() - 1) + "," + row + "]"
    } else {
        out = "[" + row + "]"
    }
    return setBodyField(body, path, out)
}

/// 删除第 i 行。
pub fn tableRemoveRowText(body str, path str, i int) str {
    let arr = fragAt(body, path)
    if json.type_of(arr) != "array" {
        return body
    }
    let n = json.len(arr)
    if i >= n {
        return body
    }
    var out = "["
    var k = 0
    var first = true
    loop {
        if k >= n {
            break
        }
        if k != i {
            if first == false {
                out = out + ","
            }
            first = false
            out = out + json.get_at(arr, k)
        }
        k = k + 1
    }
    return setBodyField(body, path, out + "]")
}

// ─── modules (modules_store surface) ────────────────────────────────────────

fn module_entry(ent str) any {
    return {
        id: unquote(json.get(ent, "id")),
        kind: unquote(json.get(ent, "kind")),
        name: unquote(json.get(ent, "name")),
        icon: unquote(json.get(ent, "icon")),
        description: unquote(json.get(ent, "description")),
        group: unquote(json.get(ent, "group")),
        format: unquote(json.get(ent, "format")),
    }
}


pub fn getHash() str {
    // no URL hash on the desktop; deep-link branch skips naturally
    return ""
}

pub fn expandGroupFor(expanded []any, groups []any, id str) []any {
    var out = []
    for x in expanded {
        out.push(x)
    }
    for grp in groups {
        var hit = false
        for m in grp.members {
            if m.id == id {
                hit = true
            }
        }
        if hit {
            var already = false
            for x in out {
                if x == grp.id {
                    already = true
                }
            }
            if already == false {
                out.push(grp.id)
            }
        }
    }
    return out
}

