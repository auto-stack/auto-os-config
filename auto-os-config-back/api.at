/// CollectionBrowser list filter (name/description substring).
pub fn filterEntities(list []any, q str) []any {
    let s = q.trim().to_lower()
    var out = []
    for e in list {
        if s == "" {
            out.push(e)
        }
        if s != "" {
            let nm = e.name.to_lower()
            let ds = e.description.to_lower()
            if nm.contains(s) || ds.contains(s) {
                out.push(e)
            }
        }
    }
    return out
}

// ─── theme (D7: file persistence on the desktop) ────────────────────────────

fn ui_state_path() str {
    return Env.local_data_dir() + "/autoos-ui.json"
}

pub fn loadAccent() str {
    let t = File.read_text(ui_state_path())
    if json.type_of(t) == "object" {
        let v = unquote(json.get(t, "accent"))
        if v == "indigo" || v == "coral" || v == "ocean" || v == "sage" || v == "amber" {
            return v
        }
    }
    return "indigo"
}

pub fn applyAccent(name str) {
    let t = File.read_text(ui_state_path())
    var next = "{\"accent\":" + quote_json(name) + "}"
    if json.type_of(t) == "object" {
        next = set_obj_field(t, "accent", quote_json(name))
    }
    File.write_text(ui_state_path(), next)
}

