pub fn modulesCount(text str) int {
    return json.len(text)
}

pub fn moduleAt(text str, i int) any {
    return module_entry(json.get_at(text, i))
}

/// Unique group labels, insertion order (index into this list = group index).
pub fn groupCount(text str) int {
    var labels = []
    let n = json.len(text)
    var i = 0
    loop {
        if i >= n {
            break
        }
        let g = unquote(json.get(json.get_at(text, i), "group"))
        if g != "" {
            var dup = false
            for x in labels {
                if x == g {
                    dup = true
                }
            }
            if dup == false {
                labels.push(g)
            }
        }
        i = i + 1
    }
    return labels.len()
}

pub fn groupAt(text str, gi int) any {
    var labels = []
    let n = json.len(text)
    var i = 0
    loop {
        if i >= n {
            break
        }
        let g = unquote(json.get(json.get_at(text, i), "group"))
        if g != "" {
            var dup = false
            for x in labels {
                if x == g {
                    dup = true
                }
            }
            if dup == false {
                labels.push(g)
            }
        }
        i = i + 1
    }
    var lab = ""
    var i2 = 0
    for x in labels {
        if i2 == gi {
            lab = x
        }
        i2 = i2 + 1
    }
    return { id: lab.to_lower().replace(" ", "-"), label: lab }
}

fn group_label_at(text str, gi int) str {
    let g = groupAt(text, gi)
    return g.label
}

pub fn groupMemberCount(text str, gi int) int {
    let lab = group_label_at(text, gi)
    var n_out = 0
    let n = json.len(text)
    var i = 0
    loop {
        if i >= n {
            break
        }
        let g = unquote(json.get(json.get_at(text, i), "group"))
        if g == lab {
            n_out = n_out + 1
        }
        i = i + 1
    }
    return n_out
}

pub fn groupMemberAt(text str, gi int, mi int) any {
    let lab = group_label_at(text, gi)
    var hits = 0
    let n = json.len(text)
    var i = 0
    loop {
        if i >= n {
            break
        }
        let ent = json.get_at(text, i)
        let g = unquote(json.get(ent, "group"))
        if g == lab {
            if hits == mi {
                return module_entry(ent)
            }
            hits = hits + 1
        }
        i = i + 1
    }
    return { id: "", kind: "", name: "", icon: "", description: "", group: "", format: "" }
}

pub fn standaloneCount(text str) int {
    var n_out = 0
    let n = json.len(text)
    var i = 0
    loop {
        if i >= n {
            break
        }
        let g = unquote(json.get(json.get_at(text, i), "group"))
        if g == "" {
            n_out = n_out + 1
        }
        i = i + 1
    }
    return n_out
}

pub fn standaloneAt(text str, si int) any {
    var hits = 0
    let n = json.len(text)
    var i = 0
    loop {
        if i >= n {
            break
        }
        let ent = json.get_at(text, i)
        let g = unquote(json.get(ent, "group"))
        if g == "" {
            if hits == si {
                return module_entry(ent)
            }
            hits = hits + 1
        }
        i = i + 1
    }
    return { id: "", kind: "", name: "", icon: "", description: "", group: "", format: "" }
}

/// Flat module selection (VG14: find-closure unavailable on vm).
pub fn selectInfo(text str, id str) any {
    let n = json.len(text)
    var i = 0
    loop {
        if i >= n {
            break
        }
        let ent = json.get_at(text, i)
        let mid = unquote(json.get(ent, "id"))
        if mid == id {
            let fmt = unquote(json.get(ent, "format"))
            return {
                found: true,
                id: mid,
                kind: unquote(json.get(ent, "kind")),
                name: unquote(json.get(ent, "name")),
                read_only: fmt == "frontmatter-md",
            }
        }
        i = i + 1
    }
    return { found: false, id: "", kind: "", name: "", read_only: false }
}


