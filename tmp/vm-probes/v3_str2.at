use auto.json

fn main() {
    let txt = "{\"name\":\"alice\",\"n\":5}"
    let row = json.parse(txt)
    let has = row.has_key("name")
    print(f"has_key: ${has}")
    let g = row.get("name")
    print(f"get nil? ${g == nil}")
    let s = row.get("name").as_string()
    print(f"as_string: '${s}'")
    let t = row.get("name").type()
    print(f"type: ${t}")
    let n = row.get("n").as_int()
    print(f"as_int: ${n}")
    let missing = row.get("zzz")
    print(f"missing nil? ${missing == nil}")
    let arr = "[{\"a\":1}]"
    let a = json.parse(arr).as_array()
    print(f"arr len: ${a.len()}")
    let a0 = a[0].get("a").as_int()
    print(f"arr[0].a: ${a0}")
}
