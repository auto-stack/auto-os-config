use probe_transport: fetch_modules_text
use probe_logic: unquote

store ProbeStore {
    model {
        var modules []any = []
        var active_id str = ""
        var loading bool = false
        var error str = ""
        var title str = "probe"
    }

    msg Msg { Init, Select(str) }

    on {
        .Init -> {
            .loading = true
            .error = ""
            let r = fetch_modules_text()
            if r.ok {
                var mods = []
                let n = json.len(r.text)
                var i = 0
                loop {
                    if i >= n {
                        break
                    }
                    let ent = json.get_at(r.text, i)
                    mods.push({
                        id: unquote(json.get(ent, "id")),
                        kind: unquote(json.get(ent, "kind")),
                        name: unquote(json.get(ent, "name")),
                        group: unquote(json.get(ent, "group")),
                    })
                    i = i + 1
                }
                .modules = mods
            }
            if r.ok == false {
                .error = r.error
                .modules = []
            }
            .loading = false
        }
        .Select(id str) -> {
            .error = "sel:" + id
            for m in .modules {
                let mid = m.id
                if mid == id {
                    .active_id = mid
                    .title = m.name
                }
            }
        }
    }
}
