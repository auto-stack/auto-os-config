// probe_transport.at — V1 FINAL recipe: text-based transport.
//   GET  -> http.get_json (returns raw JSON text; judge by json.type_of)
//   PUT/POST/DELETE -> http.put/post/delete; success verified by follow-up GET
//   NEVER: .status() (sentinel), builder chain (crashes 2nd call), res.body()
//          for truthfulness

pub fn daemon_base() str {
    return "http://127.0.0.1:17701"
}

pub fn fetch_modules_text() any {
    let t = http.get_json(daemon_base() + "/api/modules")
    if json.type_of(t) != "array" {
        return { ok: false, text: "", error: "modules: bad response" }
    }
    return { ok: true, text: t, error: "" }
}

pub fn fetch_config_text(id str) any {
    let t = http.get_json(daemon_base() + "/api/config/" + id)
    if json.type_of(t) != "object" {
        return { ok: false, text: "", error: "config: bad response" }
    }
    return { ok: true, text: t, error: "" }
}

pub fn put_config(id str, body_value str) bool {
    let payload = "{\"value\":" + body_value + "}"
    let put = http.put(daemon_base() + "/api/config/" + id, payload)
    let verify = http.get_json(daemon_base() + "/api/config/" + id)
    return json.type_of(verify) == "object"
}

pub fn put_entity(id str, name str, value str, sidecar str) bool {
    let payload = "{\"value\":" + value + ",\"sidecar\":" + sidecar + "}"
    let put = http.put(daemon_base() + "/api/collection/" + id + "/" + name, payload)
    return put != nil
}

pub fn post_entity(id str, name str) bool {
    let payload = "{\"name\":\"" + name + "\"}"
    let post = http.post(daemon_base() + "/api/collection/" + id, payload)
    return post != nil
}

pub fn delete_entity(id str, name str) bool {
    let del = http.delete(daemon_base() + "/api/collection/" + id + "/" + name)
    return del != nil
}
