pub fn is_secret_key(k str) bool {
    let lower = k.to_lower()
    return lower.ends_with("_key") || lower.contains("api_key") || lower.contains("secret") || lower.contains("token") || lower.contains("password")
}

pub fn humanize(s str) str {
    let parts = s.split("_")
    var out = ""
    for p in parts {
        if out != "" { out = out + " " }
        out = out + p.substr(0, 1).to_upper() + p.substr(1, p.len())
    }
    return out
}

pub fn body_kinds_text(s str) []any {
    var out = []
    let ks = json.keys(s)
    for k in ks {
        let vs = json.get(s, k)
        let t = json.type_of(vs)
        var kind = "scalar"
        if t == "array" {
            kind = "tags"
            if json.len(vs) > 0 && json.type_of(json.get_at(vs, 0)) == "object" {
                kind = "table"
            }
        }
        if t == "object" {
            kind = "subform"
        }
        out.push({ key: k, kind: kind, vtype: t, secret: is_secret_key(k) })
    }
    return out
}

pub fn table_sample(body any) []str {
    let models = body.provider.models
    var names = []
    for m in models {
        names.push(m.name + ":" + m.tier)
    }
    return names
}

pub fn dyn_read(body any) str {
    let k = "default_provider"
    let v = body[k]
    return v
}

pub fn blank_row(cols []str) any {
    var row = {}
    for c in cols {
        row[c] = ""
    }
    return row
}

/// json.get returns JSON-serialized values: strings keep their quotes.
pub fn unquote(v str) str {
    let n = v.len()
    if n >= 2 {
        let head = v.substr(0, 1)
        let tail = v.substr(n - 1, n)
        if head == "\"" && tail == "\"" {
            return v.substr(1, n - 1)
        }
    }
    return v
}
