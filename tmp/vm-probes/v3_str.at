use auto.json
use auto.str

fn main() {
    let q = '"'
    print("single-quote ok")
    let txt = "{" + q + "name" + q + ":" + q + q + "}"
    let row = json.parse(txt)
    let ok = row != nil
    print(f"parse ok: ${ok}")
    if ok {
        let rn = row.get("name").as_string()
        print(f"name: '${rn}'")
    }
    // escape check: does \" mean quote inside "..."?
    let e = "a\"b"
    print(f"escape len: ${e.len()}")  // 3 => \" is one quote; 4 => literal backslash
}
