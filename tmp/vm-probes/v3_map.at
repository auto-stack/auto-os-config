use auto.json

fn main() {
    // variant A: .set
    var a = {}
    a.set("x", "1")
    let av = a["x"]
    print(f"A set/read: ${av}")

    // variant B: build from pairs via json — encode a list of pairs? no.
    // variant C: json object accumulate — mutate via whole-replace + spread?
    // try: construct json text dynamically
    let cols = ["name", "base_url"]
    var txt = "{"
    var first = true
    for c in cols {
        if first == false { txt = txt + "," }
        txt = txt + "\"" + c + "\":\"\""
        first = false
    }
    txt = txt + "}"
    let row = json.parse(txt)
    let rn = row.get("name").as_string()
    let rb = row.get("base_url").as_string()
    print(f"C json-text build: name='${rn}' base='${rb}'")
}
