pub fn build() []any {
    var out = []
    out.push({ key: "a", kind: "x" })
    out.push({ key: "b", kind: "y" })
    return out
}

pub fn read_fields_of(list []any) str {
    var out = ""
    for e in list {
        if out != "" {
            out = out + ","
        }
        out = out + e.key + ":" + e.kind
    }
    return out
}

/// read loop-var fields inside a fn module
pub fn read_fields() str {
    let list = build()
    var out = ""
    for e in list {
        let k = e.key
        if out != "" {
            out = out + ","
        }
        out = out + k + ":" + e.kind
    }
    return out
}

/// pass a map into a fn and read fields (chained arg)
pub fn read_arg(m any) str {
    return m.key
}

/// rebuild a list replacing one entry (setEntry skeleton)
pub fn replace_key(list []any, key str, val str) []any {
    var out = []
    for e in list {
        if e.key == key {
            out.push({ key: key, kind: val })
        }
        if e.key != key {
            out.push(e)
        }
    }
    return out
}
