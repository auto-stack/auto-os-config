// config_editor.at — the generic, schema-free config editor (Plan 006 Phase
// 4). Port of src/components/ConfigEditor.vue. Widget-local state (fresh
// instance per module — AppShell keys by module id); the body is projected
// into CfgEntry descriptors by the ext layer and rebuilt whole on every edit
// (D4/D5). Async goes through the p.then idiom (ext imports don't auto-await).

widget ConfigEditor(module_id: str) {
    use {
        component: ScalarFields, TableField from "src/front/utils/controls_ext.ts"
        fn: fetchConfigSafe, putConfigSafe, deleteBlockSafe, configEntries, setCfgEntry, addBlockBody, confirmDeleteBlock, confirmSaveOnce, bodyHas from "src/front/utils/controls_ext.ts"
    }
    msg Msg {
        Init,
        FieldEdited(map),
        Save,
        Reload,
        ToggleAddBlock,
        NewBlockNameChanged,
        AddBlock,
        CancelAddBlock,
        DeleteBlock(str)
    }

    model {
        var loading bool = false
        var saving bool = false
        var error str = ""
        var dirty bool = false
        var meta_file str = ""
        var entries Array<str> = []
        // shadow of the raw body (kept for save / block add)
        var body Array<str> = None
        var adding_block bool = false
        var new_block_name str = ""
        var block_error str = ""
    }

    view {
        div {
            class: "config-editor"

            if .loading {
                div {
                    class: "state-msg"
                    text "Loading…"
                }
            }
            if .loading == false && .error != "" && .body == nil {
                div {
                    class: "state-msg error"
                    text f"✗ ${.error}"
                    span {
                        class: "hint"
                        text "Is the config daemon running on :17701?"
                    }
                }
            }

            if .body != nil {
                div {
                    class: "toolbar"
                    div {
                        class: "meta"
                        span {
                            class: "mono"
                            text .meta_file
                        }
                        if .dirty {
                            span {
                                class: "dirty"
                                text "● unsaved"
                            }
                        }
                    }
                    div {
                        class: "actions"
                        if .block_error != "" {
                            span {
                                class: "block-error"
                                text .block_error
                            }
                        }
                        if .adding_block {
                            input {
                                class: "block-name"
                                value: .new_block_name
                                oninput: .NewBlockNameChanged
                                onkeyup: .NewBlockNameChanged
                                onkeydown.enter: .AddBlock
                                placeholder: "block name"
                            }
                            button {
                                class: "btn"
                                onclick: .AddBlock
                                text "Add"
                            }
                            button {
                                class: "btn"
                                onclick: .CancelAddBlock
                                text "Cancel"
                            }
                        }
                        if .adding_block == false {
                            button {
                                class: "btn"
                                onclick: .ToggleAddBlock
                                text "＋ Add block"
                            }
                        }
                        button {
                            class: "btn"
                            disabled: .saving
                            onclick: .Reload
                            text "Reload"
                        }
                        button {
                            class: "btn primary"
                            disabled: .saving || .dirty == false
                            onclick: .Save
                            if .saving { text "Saving…" }
                            if .saving == false { text "Save" }
                        }
                    }
                }

                div {
                    class: "fields"
                    for e in .entries {
                        div {
                            class: "entry"
                            key: e.path

                            // nested object → SubForm block
                            if e.kind == "subform" {
                                div {
                                    class: "subform"
                                    div {
                                        class: "subform-header"
                                        span {
                                            class: "subform-title"
                                            text e.spec.label
                                        }
                                        if e.is_provider {
                                            button {
                                                class: "btn danger btn-sm"
                                                title: "Delete this block from the file"
                                                onclick: .DeleteBlock(e.key)
                                                text "🗑"
                                            }
                                        }
                                    }
                                    div {
                                        class: "subform-body"
                                        for s in e.sub {
                                            div {
                                                class: "entry"
                                                key: s.path
                                                if s.is_table {
                                                    div {
                                                        class: "field-row"
                                                        label {
                                                            class: "field-label"
                                                            text s.spec.label
                                                        }
                                                        TableField(modelValue: s.value, module_id: .module_id, path: s.path, on_value: .FieldEdited)
                                                    }
                                                }
                                                if s.is_table == false {
                                                    ScalarFields(spec: s.spec, modelValue: s.value, path: s.path, on_value: .FieldEdited)
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // top-level array of objects → table
                            if e.kind == "table" {
                                div {
                                    class: "field-row"
                                    label {
                                        class: "field-label"
                                        text e.spec.label
                                    }
                                    TableField(modelValue: e.value, module_id: .module_id, path: e.path, on_value: .FieldEdited)
                                }
                            }

                            // top-level scalar leaf
                            if e.kind == "scalar" {
                                ScalarFields(spec: e.spec, modelValue: e.value, path: e.path, on_value: .FieldEdited)
                            }
                        }
                    }
                }

                div {
                    class: "toolbar bottom"
                    div {
                        class: "actions"
                        button {
                            class: "btn primary"
                            disabled: .saving || .dirty == false
                            onclick: .Save
                            if .saving { text "Saving…" }
                            if .saving == false { text "Save" }
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            .loading = true
            .error = ""
            var p = fetchConfigSafe(.module_id)
            p.then((r) => {
                if r.ok {
                    .body = r.value
                    .entries = configEntries(r.value, .module_id)
                    .meta_file = r.meta.file
                    .dirty = false
                }
                if r.ok == false {
                    .error = r.error
                    .body = None
                }
                .loading = false
            })
        }

        .FieldEdited(args) -> {
            var r = setCfgEntry(.entries, args.path, args.value, .body, .module_id)
            .entries = r.entries
            .body = r.body
            .dirty = true
        }

        .Save -> {
            if .dirty && .body != nil {
                if confirmSaveOnce() {
                    .saving = true
                    .error = ""
                    var p = putConfigSafe(.module_id, .body)
                    p.then((r) => {
                        if r.ok { .dirty = false }
                        if r.ok == false { .error = r.error }
                        .saving = false
                    })
                }
            }
        }

        .Reload -> {
            .loading = true
            .error = ""
            var p = fetchConfigSafe(.module_id)
            p.then((r) => {
                if r.ok {
                    .body = r.value
                    .entries = configEntries(r.value, .module_id)
                    .meta_file = r.meta.file
                    .dirty = false
                }
                if r.ok == false {
                    .error = r.error
                }
                .loading = false
            })
        }

        .ToggleAddBlock -> { .adding_block = !.adding_block }
        .NewBlockNameChanged -> { .new_block_name = .new_block_name }
        .AddBlock -> {
            var name = .new_block_name.trim()
            if name != "" {
                if .body != nil {
                    if bodyHas(.body, name) {
                        .block_error = f"\"${name}\" already exists in this config"
                    }
                    if bodyHas(.body, name) == false {
                        .body = addBlockBody(.body, name)
                        .entries = configEntries(.body, .module_id)
                        .new_block_name = ""
                        .adding_block = false
                        .block_error = ""
                        .dirty = true
                    }
                }
            }
        }
        .CancelAddBlock -> {
            .adding_block = false
            .new_block_name = ""
            .block_error = ""
        }

        .DeleteBlock(name) -> {
            if confirmDeleteBlock(name) {
                .block_error = ""
                var p = deleteBlockSafe(.module_id, name)
                p.then((r) => {
                    if r.ok {
                        var q = fetchConfigSafe(.module_id)
                        q.then((rr) => {
                            if rr.ok {
                                .body = rr.value
                                .entries = configEntries(rr.value, .module_id)
                                .meta_file = rr.meta.file
                                .dirty = false
                            }
                            if rr.ok == false { .error = rr.error }
                        })
                    }
                    if r.ok == false { .block_error = f"Delete failed: ${r.error}" }
                })
            }
        }
    }

    style {
        .config-editor {
            max-width: 820px;
        }
        .toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 0 16px 0;
            border-bottom: 1px solid var(--border);
            margin-bottom: 8px;
        }
        .toolbar.bottom {
            border-bottom: none;
            border-top: 1px solid var(--border);
            margin-top: 16px;
            padding-top: 16px;
        }
        .meta {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: var(--font-size-sm);
            color: var(--text-muted);
        }
        .mono {
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        }
        .dirty {
            color: var(--accent);
            font-weight: 500;
        }
        .actions {
            display: flex;
            gap: 8px;
            margin-left: auto;
        }
        .btn {
            border: 1px solid var(--border);
            background: var(--bg-card);
            color: var(--text-primary);
            padding: 6px 16px;
            border-radius: var(--radius-sm, 4px);
            cursor: pointer;
            font-size: var(--font-size-sm);
            transition: all 0.15s;
        }
        .btn:hover:not(:disabled) {
            background: var(--bg-hover);
        }
        .btn.primary {
            background: var(--accent);
            color: var(--accent-foreground);
            border-color: var(--accent);
        }
        .btn.primary:hover:not(:disabled) {
            background: var(--accent-hover);
        }
        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .fields {
            display: flex;
            flex-direction: column;
        }
        .subform {
            border: 1px solid var(--border);
            border-radius: var(--radius, 8px);
            margin: 12px 0;
            background: var(--bg-card);
        }
        .subform-header {
            padding: 8px 14px;
            border-bottom: 1px solid var(--border);
            background: var(--bg-hover);
            border-radius: var(--radius, 8px) var(--radius, 8px) 0 0;
            font-weight: 600;
            font-size: var(--font-size-base);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .btn.danger {
            border-color: var(--danger);
            color: var(--danger);
            background: transparent;
        }
        .btn.danger:hover:not(:disabled) {
            background: rgba(196, 43, 28, 0.08);
        }
        .btn-sm {
            padding: 2px 8px;
            font-size: var(--font-size-sm);
            line-height: 1.4;
        }
        .block-name {
            width: 160px;
            padding: 5px 8px;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm, 4px);
            font-size: var(--font-size-sm);
            background: var(--bg-card);
            color: var(--text-primary);
        }
        .block-error {
            color: var(--danger);
            font-size: var(--font-size-sm);
        }
        .subform-body {
            padding: 8px 14px;
        }
        .field-row {
            display: grid;
            grid-template-columns: 160px 1fr;
            gap: 12px;
            align-items: start;
            padding: 8px 0;
        }
        .field-label {
            font-size: var(--font-size-sm);
            color: var(--text-secondary);
            padding-top: 6px;
            font-weight: 500;
        }
        .state-msg {
            padding: 14px;
            border-radius: var(--radius, 8px);
            background: var(--bg-hover);
            color: var(--text-secondary);
            font-size: var(--font-size-base);
        }
        .state-msg.error {
            background: rgba(196, 43, 28, 0.08);
            color: var(--danger);
        }
        .state-msg.error .hint {
            display: block;
            margin-top: 6px;
            font-size: var(--font-size-sm);
            opacity: 0.85;
        }
    }
}
